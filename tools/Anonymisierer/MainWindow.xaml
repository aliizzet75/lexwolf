<Window x:Class="Anonymisierer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf Anonymisierer" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Top Bar -->
        <DockPanel Background="#2C3E50" Height="60">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0">
                <TextBlock Text="🛡️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="LexWolf Anonymisierer"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                <Button Content="i️ Hilfestellung"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Transparent"
                        Click="OnHelpClicked"
                        Margin="0,0,10,0"/>
                <Button Content="⚙️ Einstellungen"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Transparent"
                        Click="OnSettingsClicked"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Content with Split Pane -->
        <Grid Margin="0,60,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - File Explorer -->
            <Border Grid.Column="0" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Background="#34495E" Grid.Row="0">
                        <TextBlock Text="📁 Dokumente"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="10">
                        <Button Content="➕ Ordner hinzufügen" 
                                Click="OnAddFolderClicked"
                                Margin="0,0,0,10"/>
                        
                        <Separator Margin="0,10,0,10"/>

                        <TextBlock Text="Fortschritt:" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,5"/>
                        
                        <ProgressBar Name="ProgressBar" 
                                       Height="20" 
                                       Minimum="0" 
                                       Maximum="100" 
                                       Value="0" 
                                       Margin="0,0,0,10"/>
                        
                        <Separator Margin="0,10,0,10"/>

                        <TextBlock Text="Dateibaum:" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,5"/>

                        <TreeView Name="FileTree" 
                                   Height="300" 
                                   Margin="0,0,0,10"
                                   SelectedItemChanged="OnFileTreeSelected">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                    </StackPanel>
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="14"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        
                        <Separator Margin="0,10,0,10"/>

                        <TextBlock Text="Dokumentenarten:" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,5"/>

                        <StackPanel>
                            <RadioButton Content="📄 Word (.docx)" IsChecked="True" Margin="0,3,0,3"/>
                            <RadioButton Content="📄 PDF (.pdf)" Margin="0,3,0,3"/>
                            <RadioButton Content="📄 Text (.txt)" Margin="0,3,0,3"/>
                            <RadioButton Content="📧 E-Mails (.eml)" Margin="0,3,0,3"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#95A5A6"/>

            <!-- Right Panel - Anonymization Preview -->
            <Border Grid.Column="2" Background="White" BorderBrush="#BDC3C7" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <DockPanel Background="#3498DB" Grid.Row="0">
                        <TextBlock Text="🔍 Anonymisierung"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Dokumentenvorschau:"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"
                                       FontSize="14"/>

                            <TextBox Name="PreviewTextBox"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="300"
                                     Margin="0,0,0,10"
                                     IsReadOnly="True"/>

                            <TextBlock Text="Erkannte Entitäten:"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"
                                       FontSize="14"/>

                            <Border BorderBrush="#BDC3C7" BorderThickness="1" Padding="10">
                                <StackPanel Name="EntitiesPanel">
                                    <TextBlock Text="Keine Entitäten erkannt."
                                               Foreground="#7F8C8D"
                                               FontStyle="Italic"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel Background="#ECF0F1" Grid.Row="2" Margin="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="🔄 Anonymisieren"
                                    Background="#27AE60"
                                    Foreground="White"
                                    Width="150"
                                    Click="OnAnonymizeClicked"
                                    Margin="5"/>

                            <Button Content="🔄 De-Anonymisieren"
                                    Background="#E67E22"
                                    Foreground="White"
                                    Width="150"
                                    Click="OnDeAnonymizeClicked"
                                    Margin="5"/>

                            <Button Content="📁 Exportieren"
                                    Background="#3498DB"
                                    Foreground="White"
                                    Width="120"
                                    Click="OnExportClicked"
                                    Margin="5"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
