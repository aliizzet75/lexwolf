<Window x:Class="Anonymisierer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf Anonymisierer v0.6" Height="750" Width="1300"
        MinHeight="550" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0d1117">
    <DockPanel>

        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <TextBlock Text="🛡️ LexWolf Anonymisierer v0.6" FontSize="16" FontWeight="Bold"
                           Foreground="#e8a838" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="📋 Details" Click="OnDetailsClicked"
                            Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d" BorderThickness="1"
                            Padding="14,6" FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                            ToolTip="Erkannte Entitäten anzeigen"/>
                    <Button Content="💾 Exportieren" Click="OnExportClicked"
                            Background="#238636" Foreground="White" BorderThickness="0"
                            Padding="14,6" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <ProgressBar Name="ProgressBar" Width="200" Height="14" Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed" DockPanel.Dock="Right" Margin="0,0,0,0"/>
                <TextBlock Name="StatusLabel" Text="Bereit" Foreground="#8b949e" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Main: 3 Spalten -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Spalte 1: Dateibaum -->
            <DockPanel Grid.Column="0" Background="#161b22">
                <Border DockPanel.Dock="Top" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <TextBlock Text="📁 Dateien" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="+ Ordner" Click="OnAddFolderClicked"
                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d" BorderThickness="1"
                                Padding="8,3" FontSize="11" Cursor="Hand"/>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,5"
                        Visibility="{Binding ElementName=FolderPathLabel, Path=Visibility}">
                    <TextBlock Name="FolderPathLabel"
                               Foreground="#58a6ff" FontSize="10" TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"
                               ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView Name="FileTree" Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="OnFileTreeSelected" Padding="4">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#c9d1d9"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#21262d"/>

            <!-- Spalte 2: Original -->
            <DockPanel Grid.Column="2" Background="#0d1117">
                <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
                    <TextBlock Text="Original" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <Grid>
                    <ScrollViewer Name="OriginalScroll"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnOriginalScrollChanged">
                        <TextBox Name="OriginalBox"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="#0d1117" Foreground="#c9d1d9"
                                 BorderThickness="0" Padding="14"
                                 FontFamily="Consolas" FontSize="12"
                                 Text="Wählen Sie eine Datei im Dateibaum aus."/>
                    </ScrollViewer>
                    <ScrollViewer Name="OriginalPdfScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel Name="OriginalPdfPanel" Margin="14,14,14,14"/>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#21262d"/>

            <!-- Spalte 3: Anonymisiert -->
            <DockPanel Grid.Column="4" Background="#0d1117">
                <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <TextBlock Text="Anonymisiert" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Name="EntityCountLabel" Foreground="#3fb950" FontSize="11"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <ScrollViewer Name="AnonymizedScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnAnonymizedScrollChanged">
                        <RichTextBox Name="AnonymizedRich"
                                     IsReadOnly="True"
                                     Background="#0d1117" Foreground="#c9d1d9"
                                     BorderThickness="0" Padding="14"
                                     FontFamily="Consolas" FontSize="12"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>
                    <ScrollViewer Name="AnonymizedPdfScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel Name="AnonymizedPdfPanel" Margin="14,14,14,14"/>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
