<Window x:Class="LexWolf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="550"
        Background="#0d1117">
    <DockPanel>

        <!-- Top: status bar -->
        <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock Text="LexWolf" FontSize="16" FontWeight="Bold" Foreground="#e8a838"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center"
                         Fill="#555" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" Text="Verbinde..." Foreground="#8b949e"
                           VerticalAlignment="Center" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Bottom: input -->
        <Border DockPanel.Dock="Bottom" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel>
                <Button x:Name="SendBtn" Content="▶  Senden" Click="OnSend"
                        DockPanel.Dock="Right"
                        Background="#1f6feb" Foreground="White" BorderThickness="0"
                        Padding="20,10" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                        Margin="10,0,0,0"/>
                <TextBox x:Name="InputBox"
                         AcceptsReturn="False" TextWrapping="NoWrap"
                         Background="#0d1117" Foreground="#c9d1d9"
                         BorderBrush="#30363d" BorderThickness="1"
                         Padding="10,8" FontSize="13"
                         VerticalContentAlignment="Center"
                         KeyDown="OnInputKeyDown"
                         Text="Wie kündige ich einem Arbeitnehmer fristgerecht?"/>
            </DockPanel>
        </Border>

        <!-- Main: left (Denkprozess) + right (Ergebnis) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Denkprozess -->
            <DockPanel Grid.Column="0" Background="#161b22">
                <Border DockPanel.Dock="Top" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
                    <TextBlock Text="Denkprozess" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <StackPanel x:Name="ReasoningPanel"/>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#21262d"/>

            <!-- Right: Ergebnis -->
            <DockPanel Grid.Column="2" Background="#0d1117">
                <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <TextBlock Text="Ergebnis" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MetaText" Foreground="#3fb950" FontSize="11"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="ResultBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Background="#0d1117" Foreground="#c9d1d9"
                             BorderThickness="0" Padding="14"
                             FontFamily="Consolas" FontSize="12"
                             Text="Bitte stellen Sie eine Anfrage."/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
