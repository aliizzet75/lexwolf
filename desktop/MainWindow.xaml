<Window x:Class="LexWolf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LexWolf"
        xmlns:controls="clr-namespace:LexWolf.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LexWolf"
        Icon="Assets/lexwolf.ico"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="550"
        Background="#0d1117"
        AllowDrop="True" PreviewDragOver="OnFensterDragOver" PreviewDragEnter="OnFensterDragOver" PreviewDrop="OnFensterDrop">
    <DockPanel>

        <!-- Top: status bar -->
        <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock Text="LexWolf" FontSize="16" FontWeight="Bold" Foreground="#e8a838"
                           DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Ellipse x:Name="StatusDot" Width="10" Height="10"
                         DockPanel.Dock="Left" VerticalAlignment="Center" Fill="#555" Margin="0,0,6,0"/>
                <Button x:Name="ReconnectBtn" Content="↻" Click="OnReconnect"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="16" Cursor="Hand" Padding="8,0" ToolTip="Verbindung prüfen"/>
                <Button x:Name="SettingsBtn" Content="⚙" Click="OnOpenSettings"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="15" Cursor="Hand" Padding="8,0" ToolTip="Einstellungen"/>
                <Button x:Name="InfoBtn" Content="?" Click="OnShowInfo"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="15" FontWeight="Bold" Cursor="Hand" Padding="8,0" ToolTip="Info"/>
                <Button x:Name="FeatureWunschBtn" Content="💡 Feature-Wunsch" Click="OnFeatureWunschClick"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="Feature-Wunsch an LexWolf senden"/>
                <Button x:Name="FeatureUebersichtBtn" Content="🗳️ Features" Click="OnFeatureUebersichtClick"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="Eigene Feature-Wünsche und laufende Entwicklungen anzeigen"/>
                <Button x:Name="ReActBtn" Content="🧠 Live-Suche" Click="OnReActClick"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="Live-Denkprozess der Rechtsrecherche anzeigen (Suchschritte, Konfidenz)"/>
                
                <!-- FolderPicker-Button für Verzeichnis-Scanning -->
                <Button x:Name="ScanFolderBtn" Content="📂 Ordner scannen" Click="OnScanFolderClicked"
                        DockPanel.Dock="Right"
                        Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d" BorderThickness="1"
                        FontSize="13" Cursor="Hand" Padding="12,6" Margin="8,0,0,0"
                        ToolTip="Verzeichnis rekursiv scannen (.docx, .pdf, .txt, .eml)"/>
                
                <!-- ProgressBar für Fortschritt -->
                <!-- Nur sichtbar während Scan/Download läuft (SetProgressBusy) — sonst
                     leicht mit einem leeren Eingabefeld zu verwechseln. -->
                <ProgressBar x:Name="ProgressBar" Width="150" Height="20" Margin="12,0,0,0"
                             DockPanel.Dock="Right" Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed"/>
                
                <StackPanel x:Name="StyleProgressPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="StyleProgressLabel" Text="LexWolf kennt Ihren Stil zu 0%" 
                               Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ProgressBar x:Name="StyleProgressBar" Width="120" Height="8" Minimum="0" Maximum="1" Value="0"
                                 Background="#21262d" BorderBrush="#30363d" Foreground="#238636"/>
                </StackPanel>
                
                <Button x:Name="NeuesMandatBtn" Content="＋ Neues Mandat" Click="OnNeuesMandatClick"
                        DockPanel.Dock="Right" Style="{StaticResource LwPrimaryButton}" Padding="12,5"
                        VerticalAlignment="Center" Margin="0,0,12,0"
                        ToolTip="Neuen Mandanten mit Akte anlegen — mit Kollisionsprüfung, Frist, Vollmacht und ersten Schritten"/>
                <ComboBox x:Name="MandantBox"
                          DockPanel.Dock="Right" Width="220"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          Style="{StaticResource DarkComboBoxStyle}"
                          IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                          SelectionChanged="OnMandantChanged"
                          DropDownOpened="OnMandantDropDownOpened"
                          PreviewKeyDown="OnMandantBoxKeyDown"
                          TextBoxBase.TextChanged="OnMandantTextChanged"
                          ToolTip="Mandant suchen oder auswählen"/>
                <TextBlock Text="Mandant:" Foreground="#8b949e" FontSize="12"
                           DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" Text="Verbinde..." Foreground="#8b949e"
                           VerticalAlignment="Center" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Main: left (Dateibaum) + right (Chat-Verlauf) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Reiter Akte (Dateibaum) | Fristen | Eingang -->
            <TabControl x:Name="LinksTabs" Grid.Column="0" Background="#161b22" Style="{StaticResource LwTabControl}"
                        BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel Background="#161b22">
                            <Border DockPanel.Dock="Top" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="6,2,6,0">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="📁 Akte"/>
                    </TabItem.Header>
            <DockPanel Background="#161b22">
                <Border DockPanel.Dock="Top" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,8">
                    <TextBox x:Name="FileTreeSearchBox"
                             Background="#0d1117" Foreground="#c9d1d9"
                             BorderBrush="#30363d" BorderThickness="1"
                             Padding="6,4" FontSize="12"
                             TextChanged="OnFileTreeSearchChanged"
                             ToolTip="Dateien/Ordner durchsuchen"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <!-- Virtualisierung eingeschaltet, damit die linke Mandanten-/Dateiliste
                         bei vielen Einträgen nur die sichtbaren Zeilen rendert. -->
                    <TreeView x:Name="FileTree" PreviewMouseDoubleClick="OnFileTreeDoubleClick"
                              SelectedItemChanged="OnFileTreeAuswahl"
                              TreeViewItem.Expanded="OnFileTreeNodeExpanded" Margin="0,0,0,10"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="⭐ Priorisierung umschalten"
                                                      Click="OnTogglePrioritize"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="📝 Bearbeiten"
                                                      Click="OnVorlageBearbeiten"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding BearbeitenMenuSichtbar}"/>
                                            <MenuItem Header="✏️ Umbenennen"
                                                      Click="OnDateiUmbenennen"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding NormalMenuSichtbar}"/>
                                            <MenuItem Header="🗑 Löschen"
                                                      Click="OnDateiLoeschen"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding NormalMenuSichtbar}"/>
                                            <MenuItem Header="📂 Anzeigen"
                                                      Click="OnDateiAnzeigen"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="🗑 Mandant löschen …"
                                                      Click="OnMandantLoeschenAusBaum"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding MandantMenuSichtbar}"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock Text="{Binding Icon}" FontSize="{DynamicResource LwSchriftGross}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource LwSchriftNormal}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAktiv}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#e8a838"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <TextBlock x:Name="FristenTabHeader" Text="⏰ Fristen"/>
                    </TabItem.Header>
                    <controls:FristenPanel x:Name="FristenPanel"/>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <TextBlock x:Name="EingangTabHeader" Text="📥 Eingang"/>
                    </TabItem.Header>
                    <controls:EingangPanel x:Name="EingangPanel"/>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#21262d"/>

            <!-- Right: Chat-Verlauf -->
            <DockPanel Grid.Column="2" Background="#0d1117">
                <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,6">
                    <DockPanel>
                        <TextBlock Text="Chat" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ClearBtn" Content="✕ Löschen" Click="OnClearChat"
                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                                FontSize="11" Cursor="Hand" Padding="8,0"/>
                        <!-- Schriftgröße von Eingabe + Ausgabe zusammen (feiner: Einstellungen) -->
                        <Button x:Name="FontLargerBtn" Content="A+" Click="OnFontLarger"
                                DockPanel.Dock="Right" ToolTip="Schrift größer (Strg + Plus)"
                                Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                                FontSize="12" FontWeight="SemiBold" Cursor="Hand" Padding="6,0"/>
                        <Button x:Name="FontSmallerBtn" Content="A−" Click="OnFontSmaller"
                                DockPanel.Dock="Right" ToolTip="Schrift kleiner (Strg + Minus)"
                                Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                                FontSize="10" FontWeight="SemiBold" Cursor="Hand" Padding="6,0"/>
                        <Button x:Name="StatistikBtn"
                                Content="📈 Statistik"
                                Click="OnStatistikClick"
                                DockPanel.Dock="Right"
                                Background="#21262d" Foreground="#c9d1d9"
                                BorderBrush="#30363d" BorderThickness="1"
                                FontSize="11" FontWeight="SemiBold"
                                Cursor="Hand" Padding="10,4" Margin="0,0,8,0"
                                ToolTip="Durchschnittliche Konfidenz der letzten 20 Antworten">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#30363d"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ZusammenfassungBtn"
                                Content="📊 Zusammenfassung"
                                Click="OnZusammenfassungClick"
                                DockPanel.Dock="Right"
                                Visibility="Collapsed"
                                Background="#21262d" Foreground="#c9d1d9"
                                BorderBrush="#30363d" BorderThickness="1"
                                FontSize="11" FontWeight="SemiBold"
                                Cursor="Hand" Padding="10,4" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#30363d"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="KopierenBtn"
                                Content="📋 Kopieren"
                                Click="OnKopierenClick"
                                DockPanel.Dock="Right"
                                Visibility="Collapsed"
                                Background="#21262d" Foreground="#c9d1d9"
                                BorderBrush="#30363d" BorderThickness="1"
                                FontSize="11" FontWeight="SemiBold"
                                Cursor="Hand" Padding="10,4" Margin="0,0,8,0"
                                ToolTip="Letzte Antwort in die Zwischenablage kopieren">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#30363d"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="NotizenBtn"
                                Content="📝 Notizen"
                                Click="OnNotizenClick"
                                DockPanel.Dock="Right"
                                Visibility="Collapsed"
                                Background="#21262d" Foreground="#c9d1d9"
                                BorderBrush="#30363d" BorderThickness="1"
                                FontSize="11" FontWeight="SemiBold"
                                Cursor="Hand" Padding="10,4" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#30363d"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Border>
                <!-- Werkzeuge für den aktiven Mandanten (sichtbar, sobald einer gewählt ist) -->
                <Border x:Name="AktenLeiste" DockPanel.Dock="Top" Background="#0d1117" BorderBrush="#30363d"
                        BorderThickness="0,0,0,1" Padding="10,8,10,0" Visibility="Collapsed">
                    <WrapPanel>
                        <Button Content="📎 Dokumente" Style="{StaticResource LwButton}" Padding="12,6" Click="OnDokumenteClick"
                                Margin="0,0,8,8" ToolTip="Dateien oder E-Mails in die Akte legen — auswählen oder einfach aufs Fenster ziehen, auch direkt aus Outlook"/>
                        <Button Content="🗂 Aktenstamm" Style="{StaticResource LwButton}" Padding="12,6" Click="OnAktenstammClick"
                                Margin="0,0,8,8" ToolTip="Beteiligte, Gericht, Aktenzeichen, Zeitleiste und Kollisionsprüfung"/>
                        <Button Content="📝 Schriftsatz" Style="{StaticResource LwButton}" Padding="12,6" Click="OnSchriftsatzClick"
                                Margin="0,0,8,8" ToolTip="Schriftsatz aus der Akte entwerfen — mit Belegen und geprüften Zitaten"/>
                        <Button x:Name="GespraechBtn" Content="🎙 Gespräch aufnehmen" Style="{StaticResource LwButton}" Padding="12,6" Click="OnGespraechClick"
                                Margin="0,0,8,8" ToolTip="Mandantengespräch lokal aufnehmen und transkribieren (Whisper) — Audio verlässt nie den PC"/>
                        <Button Content="📋 Gespräche" Style="{StaticResource LwButton}" Padding="12,6" Click="OnGespraecheAnzeigenClick"
                                Margin="0,0,8,8" ToolTip="Aufgezeichnete Gespräche vollständig ansehen oder löschen"/>
                        <Button Content="🧮 Rechner" Style="{StaticResource LwButton}" Padding="12,6" Click="OnRechnerClick"
                                Margin="0,0,8,8" ToolTip="Unterhalt, Zugewinn, Verfahrenswert, RVG — mit Rechenweg"/>
                        <Button Content="✉ Sachstand" Style="{StaticResource LwButton}" Padding="12,6" Click="OnSachstandClick"
                                Margin="0,0,8,8" ToolTip="Sachstandsmitteilung an den Mandanten in verständlicher Sprache"/>
                        <Button Content="📋 Fragebogen" Style="{StaticResource LwButton}" Padding="12,6" Click="OnFragebogenClick"
                                Margin="0,0,16,8" ToolTip="Mandanten-Fragebogen (Einkommen, Kinder, Vermögen) — füllt die Rechner vor"/>
                        <TextBlock x:Name="KollisionHinweis" Foreground="#f85149" FontSize="{DynamicResource LwSchriftNormal}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand" Visibility="Collapsed"
                                   Margin="0,0,0,8" MouseLeftButtonUp="OnKollisionHinweisClick"
                                   Text="⚠ Mögliche Interessenkollision"/>
                    </WrapPanel>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <StackPanel x:Name="ReasoningPanel"/>
                            <StackPanel x:Name="WolfLoadingPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <Storyboard x:Key="WolfPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="WolfLoadingImage"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.4" To="1.0" Duration="0:0:0.8"/>
                                    </Storyboard>
                                </StackPanel.Resources>
                                <Image x:Name="WolfLoadingImage" Source="Assets/lexwolf.ico" Width="32" Height="32"
                                       RenderOptions.BitmapScalingMode="HighQuality" Opacity="1.0"/>
                                <TextBlock x:Name="WolfLoadingText" Text="Anfrage wird verarbeitet..." Foreground="#8b949e" FontSize="12"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ChatScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12,8">
                        <StackPanel x:Name="ChatPanel">
                            <!-- Höhe = sichtbare Höhe des Chatbereichs (statt fest 500 px), damit
                                 der Chat das Fenster ausfüllt; gescrollt wird innerhalb der WebView. -->
                            <!-- AllowExternalDrop aus: eine hineingezogene PDF würde sonst den Chat ersetzen -->
                            <wv2:WebView2 x:Name="ChatWebView" Visibility="Collapsed" AllowExternalDrop="False"
                                          Height="{Binding ViewportHeight, ElementName=ChatScrollViewer}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#161b22" Padding="12,10" BorderBrush="#30363d" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <!-- Ladeanzeige des großen Sprachmodells (Diktat), oben über der ganzen Breite -->
                            <StackPanel x:Name="ModellLadePanel" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock x:Name="ModellLadeRest" DockPanel.Dock="Right" Foreground="#8b949e" FontSize="11"/>
                                    <TextBlock x:Name="ModellLadeText" Foreground="#c9d1d9" FontSize="11"
                                               Text="🎤 Großes Sprachmodell wird geladen …"/>
                                </DockPanel>
                                <ProgressBar x:Name="ModellLadeBalken" Height="4" Minimum="0" Maximum="1" Margin="0,4,0,0"
                                             Background="#21262d" BorderThickness="0" Foreground="#e8a838"/>
                            </StackPanel>
                            <!-- SendBtn zuerst + Dock=Right, damit InputBox als letztes Kind
                                 (DockPanel-Default LastChildFill=True) den Rest ausfüllt.
                                 Umgekehrte Reihenfolge machte InputBox faktisch unsichtbar,
                                 da SendBtn sonst als letztes Kind alles füllt und sein
                                 eigenes Dock="Right" ignoriert wird. -->
                            <Button x:Name="SendBtn" Content="Senden"
                                    DockPanel.Dock="Right"
                                    Width="100"
                                    Height="36"
                                    VerticalAlignment="Bottom"
                                    Click="OnSend"
                                    Background="#21262d"
                                    Foreground="#c9d1d9"
                                    BorderBrush="#30363d"
                                    BorderThickness="1"
                                    Padding="10,5"/>
                            <!-- Spracheingabe: Klick startet, zweiter Klick beendet die Aufnahme;
                                 Live-Text lokal mit Vosk, danach Nachkorrektur mit Whisper (DiktatService). -->
                            <Button x:Name="DiktatBtn" Content="🎤"
                                    DockPanel.Dock="Right"
                                    MinWidth="44"
                                    Height="36"
                                    VerticalAlignment="Bottom"
                                    Click="OnDiktatClick"
                                    Background="#21262d"
                                    Foreground="#c9d1d9"
                                    BorderBrush="#30363d"
                                    BorderThickness="1"
                                    FontSize="15"
                                    Padding="8,5"
                                    Margin="0,0,8,0"
                                    ToolTip="Diktieren — Klick startet, zweiter Klick beendet die Aufnahme. Die Erkennung läuft lokal, kein Ton verlässt den Rechner."/>
                            <!-- Wächst mit dem Text bis MaxHeight, danach scrollt es (OnInputTextChanged
                                 hält das Neueste sichtbar). Enter sendet, Umschalt+Enter = neue Zeile. -->
                            <TextBox x:Name="InputBox"
                                     Margin="0,0,8,0"
                                     MinHeight="36"
                                     MaxHeight="200"
                                     Padding="2,7"
                                     Background="#0d1117"
                                     Foreground="#c9d1d9"
                                     BorderBrush="#30363d"
                                     BorderThickness="1"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     PreviewKeyDown="OnInputKeyDown"
                                     TextChanged="OnInputTextChanged"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
