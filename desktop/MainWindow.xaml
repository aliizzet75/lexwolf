<Window x:Class="LexWolf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LexWolf"
        xmlns:controls="clr-namespace:LexWolf.Controls"
        Title="LexWolf"
        Width="1400" Height="800"
        MinWidth="1000" MinHeight="600"
        Background="#0d1117">
    <DockPanel>

        <!-- Top: status bar -->
        <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock Text="LexWolf" FontSize="16" FontWeight="Bold" Foreground="#e8a838"
                           DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Ellipse x:Name="StatusDot" Width="10" Height="10"
                         DockPanel.Dock="Left" VerticalAlignment="Center" Fill="#555" Margin="0,0,6,0"/>
                <Button x:Name="ReconnectBtn" Content="↻" Click="OnReconnect"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="16" Cursor="Hand" Padding="8,0" ToolTip="Verbindung prüfen"/>
                <Button x:Name="SettingsBtn" Content="⚙" Click="OnOpenSettings"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="15" Cursor="Hand" Padding="8,0" ToolTip="Einstellungen"/>
                
                <!-- FolderPicker-Button für Verzeichnis-Scanning -->
                <Button x:Name="ScanFolderBtn" Content="📂 Ordner scannen" Click="OnScanFolderClicked"
                        DockPanel.Dock="Right"
                        Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d" BorderThickness="1"
                        FontSize="13" Cursor="Hand" Padding="12,6" Margin="8,0,0,0"
                        ToolTip="Verzeichnis rekursiv scannen (.docx, .pdf, .txt, .eml)"/>
                
                <!-- Export-Button -->
                <Button x:Name="ExportBtn" Content="💾 Alle exportieren" Click="OnExportClicked"
                        DockPanel.Dock="Right"
                        Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d" BorderThickness="1"
                        FontSize="13" Cursor="Hand" Padding="12,6" Margin="8,0,0,0"
                        ToolTip="Anonymisierte Versionen in Ausgabeordner speichern"/>
                
                <!-- ProgressBar für Fortschritt -->
                <ProgressBar x:Name="ProgressBar" Width="150" Height="20" Margin="12,0,0,0"
                             DockPanel.Dock="Right" Minimum="0" Maximum="100" Value="0"
                             Visibility="Visible"/>
                
                <ComboBox x:Name="MandantBox"
                          DockPanel.Dock="Right" Width="220"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          Background="#21262d" Foreground="#c9d1d9"
                          BorderBrush="#30363d" BorderThickness="1"
                          FontSize="12"
                          SelectionChanged="OnMandantChanged"
                          ToolTip="Aktiven Mandanten wählen"/>
                <TextBlock x:Name="StatusText" Text="Verbinde..." Foreground="#8b949e"
                           VerticalAlignment="Center" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Main: Grid mit 3 Spalten (Dateibaum | Original | Diff) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Spalte 1: Dateibaum -->
            <DockPanel Grid.Column="0" Background="#161b22">
                <Border DockPanel.Dock="Top" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
                    <TextBlock Text="📁 Dateibaum" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <TreeView x:Name="FileTree" SelectedItemChanged="OnFileTreeItemSelected" Margin="0,0,0,10">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>

            <!-- GridSplitter Spalte 1/2 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#21262d"/>

            <!-- Spalte 2: Originalvorschau -->
            <DockPanel Grid.Column="2" Background="#0d1117">
                <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,6">
                    <DockPanel>
                        <TextBlock Text="📄 Original" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="OriginalScrollViewer" VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <FlowDocumentReader>
                        <FlowDocument x:Name="OriginalDocument" PageWidth="600">
                            <Paragraph>
                                <Run Text="Wählen Sie eine Datei im Dateibaum aus, um die Vorschau anzuzeigen." 
                                     Foreground="#8b949e"/>
                            </Paragraph>
                        </FlowDocument>
                    </FlowDocumentReader>
                </ScrollViewer>
            </DockPanel>

            <!-- GridSplitter Spalte 2/3 -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#21262d"/>

            <!-- Spalte 3: Diff-Ansicht -->
            <DockPanel Grid.Column="4" Background="#0d1117">
                <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,6">
                    <DockPanel>
                        <TextBlock Text="🔍 Diff-Ansicht" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="DiffScrollViewer" VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <FlowDocumentReader>
                        <FlowDocument x:Name="DiffDocument" PageWidth="600">
                            <Paragraph>
                                <Run Text="Klicken Sie auf 'Diff berechnen' in der Diff-Ansicht, um Original und Anonymisiert zu vergleichen." 
                                     Foreground="#8b949e"/>
                            </Paragraph>
                        </FlowDocument>
                    </FlowDocumentReader>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
