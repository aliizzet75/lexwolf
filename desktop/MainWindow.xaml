<Window x:Class="LexWolf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LexWolf"
        Title="LexWolf"
        Icon="Assets/lexwolf.ico"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="550"
        Background="#0d1117">
    <Window.Resources>
        <!-- Dark-Theme ComboBox: die Standard-Vorlage ignoriert Background/Foreground
             für Popup und Chrome weitgehend — ohne eigenes ControlTemplate wirkt sie
             auf dunklem Grund ausgegraut / kaum lesbar. -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161b22"/>
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30363d"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21262d"/>
                                <Setter Property="Foreground" Value="#e8a838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0d1117"/>
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="MainBorder" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>

                            <ToggleButton x:Name="ToggleBtn" Grid.ColumnSpan="2"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBlock Grid.Column="1" Text="▾" Foreground="#8b949e" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Margin="{TemplateBinding Padding}"
                                     Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"
                                     Focusable="{TemplateBinding IsEditable}"/>

                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"/>

                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1"
                                        MaxHeight="240"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>

        <!-- Top: status bar -->
        <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock Text="LexWolf" FontSize="16" FontWeight="Bold" Foreground="#e8a838"
                           DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Ellipse x:Name="StatusDot" Width="10" Height="10"
                         DockPanel.Dock="Left" VerticalAlignment="Center" Fill="#555" Margin="0,0,6,0"/>
                <Button x:Name="ReconnectBtn" Content="↻" Click="OnReconnect"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="16" Cursor="Hand" Padding="8,0" ToolTip="Verbindung prüfen"/>
                <Button x:Name="SettingsBtn" Content="⚙" Click="OnOpenSettings"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="15" Cursor="Hand" Padding="8,0" ToolTip="Einstellungen"/>
                <Button x:Name="InfoBtn" Content="?" Click="OnShowInfo"
                        DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                        FontSize="15" FontWeight="Bold" Cursor="Hand" Padding="8,0" ToolTip="Info"/>
                
                <!-- FolderPicker-Button für Verzeichnis-Scanning -->
                <Button x:Name="ScanFolderBtn" Content="📂 Ordner scannen" Click="OnScanFolderClicked"
                        DockPanel.Dock="Right"
                        Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d" BorderThickness="1"
                        FontSize="13" Cursor="Hand" Padding="12,6" Margin="8,0,0,0"
                        ToolTip="Verzeichnis rekursiv scannen (.docx, .pdf, .txt, .eml)"/>
                
                <!-- ProgressBar für Fortschritt -->
                <!-- Nur sichtbar während Scan/Download läuft (SetProgressBusy) — sonst
                     leicht mit einem leeren Eingabefeld zu verwechseln. -->
                <ProgressBar x:Name="ProgressBar" Width="150" Height="20" Margin="12,0,0,0"
                             DockPanel.Dock="Right" Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed"/>
                
                <ComboBox x:Name="MandantBox"
                          DockPanel.Dock="Right" Width="220"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          Style="{StaticResource DarkComboBoxStyle}"
                          IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                          SelectionChanged="OnMandantChanged"
                          PreviewKeyDown="OnMandantBoxKeyDown"
                          ToolTip="Mandant suchen oder auswählen"/>
                <TextBlock Text="Mandant:" Foreground="#8b949e" FontSize="12"
                           DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" Text="Verbinde..." Foreground="#8b949e"
                           VerticalAlignment="Center" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Main: left (Dateibaum) + right (Chat-Verlauf) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Dateibaum mit TreeView -->
            <DockPanel Grid.Column="0" Background="#161b22">
                <Border DockPanel.Dock="Top" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
                    <TextBlock Text="Dateibaum" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <Border DockPanel.Dock="Top" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,8">
                    <TextBox x:Name="FileTreeSearchBox"
                             Background="#0d1117" Foreground="#c9d1d9"
                             BorderBrush="#30363d" BorderThickness="1"
                             Padding="6,4" FontSize="12"
                             TextChanged="OnFileTreeSearchChanged"
                             ToolTip="Dateien/Ordner durchsuchen"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <!-- Einfacher Klick wählt nur aus. Doppelklick öffnet die Datei im
                         Standardprogramm (OnFileTreeDoubleClick). Rechtsklick bietet
                         Priorisieren fürs Chat-Kontext an (OnTogglePrioritize). -->
                    <TreeView x:Name="FileTree" PreviewMouseDoubleClick="OnFileTreeDoubleClick" Margin="0,0,0,10">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="⭐ Priorisierung umschalten"
                                                      Click="OnTogglePrioritize"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#21262d"/>

            <!-- Right: Chat-Verlauf -->
            <DockPanel Grid.Column="2" Background="#0d1117">
                <Border DockPanel.Dock="Top" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,6">
                    <DockPanel>
                        <TextBlock Text="Chat" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ClearBtn" Content="✕ Löschen" Click="OnClearChat"
                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                                FontSize="11" Cursor="Hand" Padding="8,0"/>
                        <Button x:Name="UnterhaltBtn"
                                Content="⚖ Unterhalt berechnen"
                                Click="OnUnterhaltBtnClick"
                                DockPanel.Dock="Right"
                                Visibility="Collapsed"
                                Background="#21262d" Foreground="#e8a838"
                                BorderBrush="#30363d" BorderThickness="1"
                                FontSize="11" FontWeight="SemiBold"
                                Cursor="Hand" Padding="10,4" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#30363d"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel x:Name="ReasoningPanel"/>
                    </Border>

                    <ScrollViewer x:Name="ChatScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12,8">
                        <StackPanel x:Name="ChatPanel"/>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#161b22" Padding="12,10" BorderBrush="#30363d" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <!-- SendBtn zuerst + Dock=Right, damit InputBox als letztes Kind
                                 (DockPanel-Default LastChildFill=True) den Rest ausfüllt.
                                 Umgekehrte Reihenfolge machte InputBox faktisch unsichtbar,
                                 da SendBtn sonst als letztes Kind alles füllt und sein
                                 eigenes Dock="Right" ignoriert wird. -->
                            <Button x:Name="SendBtn" Content="Senden"
                                    DockPanel.Dock="Right"
                                    Width="100"
                                    Click="OnSend"
                                    Background="#21262d"
                                    Foreground="#c9d1d9"
                                    BorderBrush="#30363d"
                                    BorderThickness="1"
                                    Padding="10,5"/>
                            <TextBox x:Name="InputBox"
                                     Margin="0,0,8,0"
                                     Height="36"
                                     Background="#0d1117"
                                     Foreground="#c9d1d9"
                                     BorderBrush="#30363d"
                                     BorderThickness="1"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Center"
                                     KeyDown="OnInputKeyDown"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
