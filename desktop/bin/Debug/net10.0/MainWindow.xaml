<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Datei">
                <MenuItem Header="Neu" />
                <MenuItem Header="Öffnen" />
                <Separator />
                <MenuItem Header="Beenden" />
            </MenuItem>
            <MenuItem Header="Ansicht" />
            <MenuItem Header="Hilfe" />
        </Menu>
        <Grid DockPanel.Dock="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Panel 1: Denkprozess-Fenster (scrollbar, links) -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Denkprozess"
                           FontWeight="Bold" Padding="8,6"
                           Background="#1E1E2E" Foreground="White" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox Name="DenkprozessBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             Background="#1E1E2E" Foreground="#CDD6F4"
                             Padding="8" />
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#313244" />

            <!-- Panel 2: Rich-Text-Editor (Mitte) -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Editor"
                           FontWeight="Bold" Padding="8,6"
                           Background="#1E1E2E" Foreground="White" />
                <RichTextBox Name="EditorBox"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             SpellCheck.IsEnabled="True"
                             Background="#181825" Foreground="#CDD6F4"
                             Padding="12" FontSize="14"
                             FontFamily="Segoe UI, Arial">
                    <FlowDocument>
                        <Paragraph>
                            <Run Text="" />
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#313244" />

            <!-- Panel 3: Mandanten-Info (rechts) -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Mandant"
                           FontWeight="Bold" Padding="8,6"
                           Background="#1E1E2E" Foreground="White" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Name:" Foreground="#6C7086" Margin="0,4,0,2" />
                        <TextBox Name="MandantName" Background="#1E1E2E"
                                 Foreground="#CDD6F4" Padding="4" />
                        <TextBlock Text="Aktenzeichen:" Foreground="#6C7086" Margin="0,8,0,2" />
                        <TextBox Name="Aktenzeichen" Background="#1E1E2E"
                                 Foreground="#CDD6F4" Padding="4" />
                        <TextBlock Text="Notizen:" Foreground="#6C7086" Margin="0,8,0,2" />
                        <TextBox Name="MandantNotizen"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="120"
                                 Background="#1E1E2E"
                                 Foreground="#CDD6F4" Padding="4" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
