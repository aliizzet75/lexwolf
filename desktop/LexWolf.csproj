<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0 (statt nur "net10.0-windows") wird für die WinRT-APIs
         Windows.Data.Pdf (PDF-Seite -> Bitmap) und Windows.Media.Ocr (Bitmap -> Text)
         gebraucht, beide fest im Betriebssystem — keine zusätzlichen Bibliotheken
         zu bündeln. 19041 = Windows 10 Version 2004 (Mai 2020), sichere Baseline. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LexWolf</AssemblyName>
    <RootNamespace>LexWolf</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.4.9</Version>
    <ApplicationIcon>Assets\lexwolf.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="DiffPlex" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon setzt nur das .exe-Icon (Explorer/Taskleiste-Datei) —
         als WPF-Resource eingebunden, damit die Icon="Assets/..."-Referenzen
         in MainWindow.xaml / den Dialogen zur Laufzeit auflösbar sind. -->
    <Resource Include="Assets\lexwolf.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- LexWolf.Tests ist ein eigenes Projekt im selben Ordner (plattformunabhängig,
         damit PDF-Extraktion auch unter Linux/CI testbar ist) — sonst globbt das
         Haupt-SDK-Projekt dessen .cs-Dateien versehentlich mit ein. -->
    <Compile Remove="LexWolf.Tests\**\*.cs" />
    <None Remove="LexWolf.Tests\**\*.cs" />
  </ItemGroup>
</Project>
