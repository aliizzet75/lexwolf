<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0 (statt nur "net10.0-windows") wird für die WinRT-APIs
         Windows.Data.Pdf (PDF-Seite -> Bitmap) und Windows.Media.Ocr (Bitmap -> Text)
         gebraucht, beide fest im Betriebssystem — keine zusätzlichen Bibliotheken
         zu bündeln. 19041 = Windows 10 Version 2004 (Mai 2020), sichere Baseline. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LexWolf</AssemblyName>
    <RootNamespace>LexWolf</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.72.0</Version>
    <ApplicationIcon>Assets\lexwolf.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="OpenMcdf" Version="3.3.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="DiffPlex" Version="1.7.0" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\lexwolf.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- LexWolf.Tests ist ein eigenes Projekt im selben Ordner (plattformunabhängig,
         damit PDF-Extraktion auch unter Linux/CI testbar ist) — sonst globbt das
         Haupt-SDK-Projekt dessen .cs-Dateien versehentlich mit ein. -->
    <Compile Remove="LexWolf.Tests\**\*.cs" />
    <None Remove="LexWolf.Tests\**\*.cs" />
  </ItemGroup>

  <!-- Whisper.net (Spracheingabe) lädt seine nativen DLLs selbst aus
       runtimes\win-x64\ neben der .exe. In der Single-File-.exe (release.sh)
       fände es sie nicht — daher werden sie neben die .exe gelegt (der
       Installer kopiert den Ordner mit) und die Dateien der anderen
       Plattformen gar nicht erst veröffentlicht. -->
  <Target Name="WhisperNativeNichtBuendeln" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/win-x64/')) And $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').Contains('whisper'))" ExcludeFromSingleFile="true" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/win-x64/'))" />
    </ItemGroup>
  </Target>
</Project>
