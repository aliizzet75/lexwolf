<Window x:Class="LexWolf.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Einstellungen"
        Icon="/Assets/lexwolf.ico"
        Width="680" Height="480"
        MinWidth="560" MinHeight="380"
        Background="#0d1117"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Nav item style -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground"        Value="#8b949e"/>
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Padding"           Value="14,8"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="4,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21262d"/>
                                <Setter Property="Foreground" Value="#e6edf3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161b22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input style -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background"        Value="#0d1117"/>
            <Setter Property="Foreground"        Value="#c9d1d9"/>
            <Setter Property="BorderBrush"       Value="#30363d"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="10,7"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"        Value="#c9d1d9"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"        Value="#1f6feb"/>
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="20,8"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#388bfd"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1158c7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="#8b949e"/>
            <Setter Property="BorderBrush"       Value="#30363d"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="20,8"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#21262d"/>
                                <Setter Property="Foreground" Value="#c9d1d9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Body: nav + content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left nav -->
            <Border Grid.Column="0" Background="#161b22"
                    BorderBrush="#30363d" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,16,16,8">
                        <TextBlock Text="Einstellungen" Foreground="#e6edf3"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnNavChanged" Padding="4,0">
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="allgemein">Allgemein</ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right content -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,16">

                    <!-- === Allgemein === -->
                    <StackPanel x:Name="PanelAllgemein">

                        <TextBlock Text="Allgemein" Foreground="#e6edf3"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <!-- Dokumente-Verzeichnis -->
                        <TextBlock Text="Dokumente-Verzeichnis"
                                   Foreground="#c9d1d9" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="#8b949e" FontSize="12">
                            Ordner, in dem Mandanten-Unterordner mit Dokumenten liegen.
                            Der Scanner überwacht diesen Ordner live.
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DokumentePfadBox"
                                     Grid.Column="0"
                                     Style="{StaticResource Input}"
                                     Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="Durchsuchen…"
                                    Style="{StaticResource GhostBtn}"
                                    Padding="12,7"
                                    Click="OnBrowse"/>
                        </Grid>

                        <TextBlock Text="Briefkopf"
                                   Foreground="#c9d1d9" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,20,0,4"/>
                        <TextBox x:Name="BriefkopfBox"
                                 Style="{StaticResource Input}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Briefende"
                                   Foreground="#c9d1d9" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="BriefendeBox"
                                 Style="{StaticResource Input}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"/>

                        <Separator Background="#21262d" Margin="0,28,0,0"/>
                    </StackPanel>

                    <!-- Weitere Sektionen kommen hier als StackPanel x:Name="PanelXxx" -->

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer: actions -->
        <Border Grid.Row="1" Background="#161b22"
                BorderBrush="#30363d" BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <TextBlock x:Name="StatusLabel" DockPanel.Dock="Left"
                           Foreground="#3fb950" FontSize="12"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Style="{StaticResource GhostBtn}"
                            Margin="0,0,8,0" Click="OnCancel"/>
                    <Button Content="Speichern"  Style="{StaticResource PrimaryBtn}"
                            Click="OnSave"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
