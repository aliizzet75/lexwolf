<Window x:Class="LexWolf.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Einstellungen"
        Icon="/Assets/lexwolf.ico"
        Width="680" Height="480"
        MinWidth="560" MinHeight="380"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Nav item style -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground"        Value="{DynamicResource LwMuted}"/>
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Padding"           Value="14,8"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="4,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LwRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource LwTextStrong}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LwPanel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input style -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background"        Value="{DynamicResource LwBg}"/>
            <Setter Property="Foreground"        Value="{DynamicResource LwText}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource LwBorder}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="10,7"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"        Value="{DynamicResource LwText}"/>
        </Style>

        <!-- Slider style -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Background"        Value="{DynamicResource LwRaised}"/>
            <Setter Property="Foreground"        Value="{DynamicResource LwPrimary}"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency"     Value="1"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"        Value="{DynamicResource LwPrimary}"/>
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="20,8"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource LwPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource LwPrimaryPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="{DynamicResource LwMuted}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource LwBorder}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="20,8"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource LwRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource LwText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Body: nav + content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left nav -->
            <Border Grid.Column="0" Background="{DynamicResource LwPanel}"
                    BorderBrush="{DynamicResource LwBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,16,16,8">
                        <TextBlock Text="Einstellungen" Foreground="{DynamicResource LwTextStrong}"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnNavChanged" Padding="4,0">
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="allgemein">Allgemein</ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="darstellung">Darstellung</ListBoxItem>
                        <!-- Spracheingabe vorerst versteckt, siehe PanelSprache weiter unten -->
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="ki_modell">KI-Modell (Test)</ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right content -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,16">

                    <!-- === Allgemein === -->
                    <StackPanel x:Name="PanelAllgemein">

                        <TextBlock Text="Allgemein" Foreground="{DynamicResource LwTextStrong}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <!-- Dokumente-Verzeichnis -->
                        <TextBlock Text="Dokumente-Verzeichnis"
                                   Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12">
                            Ordner, in dem Mandanten-Unterordner mit Dokumenten liegen.
                            Der Scanner überwacht diesen Ordner live.
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DokumentePfadBox"
                                     Grid.Column="0"
                                     Style="{StaticResource Input}"
                                     Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="Durchsuchen…"
                                    Style="{StaticResource GhostBtn}"
                                    Padding="12,7"
                                    Click="OnBrowse"/>
                        </Grid>

                        <TextBlock Text="Briefkopf (Kanzleiname, Adresse)"
                                   Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,20,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12">
                            Wird oben in neue Schriftsatz-Entwürfe und in den Chat-Kontext eingefügt.
                        </TextBlock>
                        <TextBox x:Name="BriefkopfBox"
                                 Style="{StaticResource Input}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Briefende (Grußformel, Unterschrift)"
                                   Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="BriefendeBox"
                                 Style="{StaticResource Input}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Ort (für Datum/Ort-Zeile im Schriftsatz)"
                                   Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12">
                            Z. B. „Düsseldorf" — zusammen mit dem heutigen Datum automatisch im Entwurf.
                        </TextBlock>
                        <TextBox x:Name="KanzleiOrtBox"
                                 Style="{StaticResource Input}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Kontodaten"
                                   Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12">
                            Bank, IBAN, BIC — wird nur eingefügt, wenn der Entwurf Zahlungsangaben braucht (z. B. Kostennote).
                        </TextBlock>
                        <TextBox x:Name="KanzleiKontodatenBox"
                                 Style="{StaticResource Input}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="60"/>

                        <TextBlock Text="Bundesland"
                                   Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,20,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12">
                            Für die Feiertage bei der Fristberechnung (Gerichtsort).
                        </TextBlock>
                        <ComboBox x:Name="BundeslandBox" Style="{StaticResource DarkComboBoxStyle}"
                                  HorizontalAlignment="Left" Width="220"
                                  DisplayMemberPath="Value" SelectedValuePath="Key"/>

                        <Separator Background="{DynamicResource LwRaised}" Margin="0,28,0,20"/>

                        <!-- === Feedback & Datenschutz === -->
                        <TextBlock Text="Feedback &amp; Datenschutz" Foreground="{DynamicResource LwTextStrong}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12" LineHeight="18">
                            Hier entscheiden Sie, ob LexWolf Daten zur Verbesserung des Schreibstils mit uns teilen darf. Es werden ausschließlich anonymisierte Stil-Metriken übermittelt – keine Inhalte Ihrer Schriftsätze, keine Mandantendaten, keine §-Referenzen und keine Geldbeträge.
                        </TextBlock>

                        <CheckBox x:Name="FeedbackOptInBox" Foreground="{DynamicResource LwText}" FontSize="13"
                                  Margin="0,0,0,10" VerticalContentAlignment="Center">
                            <TextBlock Text="Stil-Verbesserungen senden" Foreground="{DynamicResource LwText}" FontSize="13"/>
                        </CheckBox>
                        <TextBlock TextWrapping="Wrap" Margin="24,0,0,18"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12">
                            Beispiel: Durchschnittliche Satzlängen, Satzbausteine und Häufigkeiten von Korrekturkategorien.
                        </TextBlock>

                        <CheckBox x:Name="AbTestOptInBox" Foreground="{DynamicResource LwText}" FontSize="13"
                                  Margin="0,0,0,10" VerticalContentAlignment="Center">
                            <TextBlock Text="A/B-Tests teilnehmen" Foreground="{DynamicResource LwText}" FontSize="13"/>
                        </CheckBox>
                        <TextBlock TextWrapping="Wrap" Margin="24,0,0,0"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12">
                            Sie erhalten gelegentlich zwei alternative Formulierungen. Die Wahl wird anonymisiert ausgewertet, um den Schreibstil zu verbessern.
                        </TextBlock>

                    </StackPanel>

                    <!-- === Darstellung === -->
                    <StackPanel x:Name="PanelDarstellung" Visibility="Collapsed">

                        <TextBlock Text="Darstellung" Foreground="{DynamicResource LwTextStrong}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <CheckBox x:Name="DunkelModusBox" Foreground="{DynamicResource LwText}" FontSize="13"
                                  Margin="0,0,0,16" VerticalContentAlignment="Center"
                                  Checked="OnDunkelModusChanged" Unchecked="OnDunkelModusChanged">
                            <TextBlock Text="Dunkles Design" Foreground="{DynamicResource LwText}" FontSize="13"/>
                        </CheckBox>

                        <TextBlock Text="Chat-Eingabefeld"
                                   Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="InputFontCombo" Grid.Column="0" Margin="0,0,8,0"
                                      Style="{StaticResource DarkComboBoxStyle}"/>
                            <Slider x:Name="InputFontSizeSlider" Grid.Column="1" Width="160"
                                    Minimum="8" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Style="{StaticResource DarkSlider}"
                                    ValueChanged="OnInputFontSizeChanged"/>
                        </Grid>
                        <TextBlock x:Name="InputFontSizeLabel" Foreground="{DynamicResource LwMuted}" FontSize="12"
                                   Margin="0,-8,0,18"/>

                        <TextBlock Text="Chat-Ausgabe (WebView2)"
                                   Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="OutputFontCombo" Grid.Column="0" Margin="0,0,8,0"
                                      Style="{StaticResource DarkComboBoxStyle}"/>
                            <Slider x:Name="OutputFontSizeSlider" Grid.Column="1" Width="160"
                                    Minimum="8" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Style="{StaticResource DarkSlider}"
                                    ValueChanged="OnOutputFontSizeChanged"/>
                        </Grid>
                        <TextBlock x:Name="OutputFontSizeLabel" Foreground="{DynamicResource LwMuted}" FontSize="12"
                                   Margin="0,-8,0,0"/>

                        <Border Background="{DynamicResource LwPanel}" BorderBrush="{DynamicResource LwBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,24,0,0">
                            <TextBlock x:Name="PreviewText" Text="Vorschau: Dies ist ein Beispieltext."
                                       Foreground="{DynamicResource LwText}" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>

                    <!-- === Spracheingabe === -->
                    <StackPanel x:Name="PanelSprache" Visibility="Collapsed">

                        <TextBlock Text="Spracheingabe" Foreground="{DynamicResource LwTextStrong}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <CheckBox x:Name="VoskGrossBox" Foreground="{DynamicResource LwText}" FontSize="13"
                                  Margin="0,0,0,10" VerticalContentAlignment="Center">
                            <TextBlock Text="Großes Sprachmodell beim Start laden" Foreground="{DynamicResource LwText}" FontSize="13"/>
                        </CheckBox>
                        <TextBlock TextWrapping="Wrap" Margin="24,0,0,8"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12" LineHeight="18">
                            Das große Modell erkennt Diktate deutlich genauer, braucht aber rund 3 GB Arbeitsspeicher und lädt einige Minuten im Hintergrund. Ohne diese Option diktiert LexWolf mit dem kleinen Modell. Ausschalten wirkt ab dem nächsten Start.
                        </TextBlock>
                        <TextBlock x:Name="VoskGrossStatus" TextWrapping="Wrap" Margin="24,0,0,0"
                                   Foreground="{DynamicResource LwDisabledText}" FontSize="11"/>

                    </StackPanel>

                    <!-- === KI-Modell (Test) === -->
                    <StackPanel x:Name="PanelKiModell" Visibility="Collapsed">

                        <TextBlock Text="KI-Modell (Test)" Foreground="{DynamicResource LwTextStrong}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,20"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12" LineHeight="18">
                            Zum Testen umschaltbar, welches KI-Modell LexWolf tatsächlich verwendet — wirkt
                            sofort beim Klick auf „Übernehmen", unabhängig vom restlichen „Speichern" dieses
                            Fensters.
                        </TextBlock>

                        <TextBlock Text="Modus" Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="KiModusBox" Style="{StaticResource DarkComboBoxStyle}"
                                  HorizontalAlignment="Left" Width="260" Margin="0,0,0,16"
                                  SelectionChanged="OnKiModusChanged">
                            <ComboBoxItem Content="Localhost (wie bisher)" Tag="localhost"/>
                            <ComboBoxItem Content="Hybrid (zwei Modelle)" Tag="hybrid"/>
                            <ComboBoxItem Content="Alles über ein Modell" Tag="ein_modell"/>
                        </ComboBox>

                        <!-- Ein Modell -->
                        <StackPanel x:Name="KiEinModellPanel" Visibility="Collapsed">
                            <TextBlock Text="Anbieter" Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="KiAnbieterBox" Style="{StaticResource DarkComboBoxStyle}"
                                      HorizontalAlignment="Left" Width="260" Margin="0,0,0,12"
                                      SelectionChanged="OnKiAnbieterChanged">
                                <ComboBoxItem Content="Claude Code" Tag="claude_code"/>
                                <ComboBoxItem Content="Ollama Cloud" Tag="ollama"/>
                            </ComboBox>
                            <TextBlock Text="Modell" Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="KiEinModellModellBox" Style="{StaticResource DarkComboBoxStyle}"
                                      HorizontalAlignment="Left" Width="320" Margin="0,0,0,16"
                                      DisplayMemberPath="Anzeige"/>
                        </StackPanel>

                        <!-- Hybrid -->
                        <StackPanel x:Name="KiHybridPanel" Visibility="Collapsed">
                            <TextBlock Text="Claude-Code-Modell" Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="KiHybridClaudeBox" Style="{StaticResource DarkComboBoxStyle}"
                                      HorizontalAlignment="Left" Width="320" Margin="0,0,0,12"
                                      DisplayMemberPath="Anzeige"/>
                            <TextBlock Text="Ollama-Cloud-Modell" Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="KiHybridOllamaBox" Style="{StaticResource DarkComboBoxStyle}"
                                      HorizontalAlignment="Left" Width="320" Margin="0,0,0,12"
                                      DisplayMemberPath="Anzeige"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                                       Foreground="{DynamicResource LwMuted}" FontSize="12" LineHeight="18">
                                Kurze/einfache Anfragen gehen automatisch an das günstigere, aufwändige
                                Entwürfe (z.B. Schriftsätze) an das teurere der beiden Modelle.
                            </TextBlock>
                        </StackPanel>

                        <Separator Background="{DynamicResource LwRaised}" Margin="0,4,0,20"/>

                        <TextBlock Text="Claude Code API-Key" Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource LwMuted}" FontSize="12">
                            Ohne Key läuft Claude Code über den lokalen Entwickler-Proxy (kein eigener Zugang
                            nötig). Mit Key geht es direkt über die Anthropic-API.
                        </TextBlock>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="KiApiKeyBox" Grid.Column="0"
                                         Background="{DynamicResource LwBg}" Foreground="{DynamicResource LwText}"
                                         BorderBrush="{DynamicResource LwBorder}" BorderThickness="1"
                                         Padding="10,7" FontSize="13" CaretBrush="{DynamicResource LwText}"
                                         VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="Entfernen" Style="{StaticResource GhostBtn}"
                                    Padding="12,7" Click="OnKiApiKeyEntfernen"/>
                        </Grid>
                        <TextBlock x:Name="KiApiKeyStatus" Foreground="{DynamicResource LwDisabledText}" FontSize="11" Margin="0,0,0,20"/>

                        <Button x:Name="KiUebernehmenBtn" Content="Übernehmen" Style="{StaticResource PrimaryBtn}"
                                HorizontalAlignment="Left" Click="OnKiUebernehmen"/>
                        <TextBlock x:Name="KiStatusLabel" FontSize="12" Margin="0,10,0,0"/>

                    </StackPanel>

                    <!-- Weitere Sektionen kommen hier als StackPanel x:Name="PanelXxx" -->

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer: actions -->
        <Border Grid.Row="1" Background="{DynamicResource LwPanel}"
                BorderBrush="{DynamicResource LwBorder}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <TextBlock x:Name="StatusLabel" DockPanel.Dock="Left"
                           Foreground="#3fb950" FontSize="12"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Style="{StaticResource GhostBtn}"
                            Margin="0,0,8,0" Click="OnCancel"/>
                    <Button Content="Speichern"  Style="{StaticResource PrimaryBtn}"
                            Click="OnSave"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
