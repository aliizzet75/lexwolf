<Window x:Class="LexWolf.Dialogs.FeatureUebersichtDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Feature-Wünsche &amp; Entwicklungen"
        Icon="/Assets/lexwolf.ico"
        Width="760" Height="560"
        MinWidth="560" MinHeight="420"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LwTextStrong}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource LwMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LwBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource LwRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource LwText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FeatureListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource LwPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource LwText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LwBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <DataTemplate x:Key="FeatureItemTemplate">
            <Border BorderBrush="{DynamicResource LwBorder}" BorderThickness="0,0,0,1" Padding="6,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Titel}" Foreground="{DynamicResource LwTextStrong}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Beschreibung}" Foreground="{DynamicResource LwMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusBadge}"
                            Background="{Binding StatusBrush}">
                        <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource LwStatusBadgeText}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🗳️ Eigene Feature-Wünsche &amp; Laufende Entwicklungen" Foreground="{DynamicResource LwTextStrong}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Hier sehen Sie Ihre eingereichten Wünsche mit Status und was das LexWolf-Team aktuell entwickelt."
                       Foreground="{DynamicResource LwMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="📥 Eigene Feature-Wünsche" DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"/>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource LwPanel}" BorderBrush="{DynamicResource LwBorder}" BorderThickness="1" CornerRadius="6">
                <ListBox x:Name="EigeneFeatureWuenscheList"
                         Style="{StaticResource FeatureListBox}"
                         ItemTemplate="{StaticResource FeatureItemTemplate}"
                         BorderThickness="0" Background="Transparent"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2">
            <TextBlock Text="🚧 Laufende Entwicklungen" DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"/>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource LwPanel}" BorderBrush="{DynamicResource LwBorder}" BorderThickness="1" CornerRadius="6">
                <ListBox x:Name="LaufendeEntwicklungenList"
                         Style="{StaticResource FeatureListBox}"
                         ItemTemplate="{StaticResource FeatureItemTemplate}"
                         BorderThickness="0" Background="Transparent"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Aktualisieren" Style="{StaticResource GhostBtn}" Click="OnRefreshClick" Margin="0,0,8,0"/>
            <Button Content="Schließen" Style="{StaticResource GhostBtn}" IsCancel="True" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
