<Window x:Class="LexWolf.Dialogs.AkteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Aktenstamm"
        Icon="/Assets/lexwolf.ico"
        Width="1080" Height="740" MinWidth="820" MinHeight="540"
        Background="#0d1117"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource LwLabel}">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FormFeld" TargetType="TextBox" BasedOn="{StaticResource LwTextBox}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Kopf -->
        <Border DockPanel.Dock="Top" Padding="24,18,24,14" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Aktenstamm" Style="{StaticResource LwDialogTitel}"/>
                <TextBlock x:Name="UntertitelText" Style="{StaticResource LwDialogUntertitel}"/>
            </StackPanel>
        </Border>

        <!-- Fuß -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource LwFussleiste}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AuswertenBtn" Content="🔍 Akte auswerten" Style="{StaticResource LwButton}" Click="OnAuswerten"
                            ToolTip="Noch nicht ausgewertete Dokumente lesen lassen: Fristen, Beteiligte, Zeitleiste"/>
                    <Button Content="Speichern" Style="{StaticResource LwPrimaryButton}" Margin="8,0,0,0" Click="OnSpeichern"/>
                    <Button Content="Schließen" Style="{StaticResource LwButton}" Margin="8,0,0,0" IsCancel="True" Click="OnSchliessen"/>
                </StackPanel>
                <!-- Bewusst abseits der übrigen Knöpfe und unauffällig -->
                <Button DockPanel.Dock="Left" Content="🗑 Mandant löschen …" Style="{StaticResource LwSmallButton}" Foreground="#f85149"
                        Margin="0,0,16,0" VerticalAlignment="Center" Click="OnLoeschen"
                        ToolTip="Mandant mit Aktenordner und allen Daten löschen — mit Sicherheitsabfrage"/>
                <TextBlock x:Name="AuswertungText" Style="{StaticResource LwStatus}"/>
            </DockPanel>
        </Border>

        <Grid Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Kollisionswarnung -->
            <Border x:Name="KollisionBanner" Background="#2d1416" BorderBrush="#f85149" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="⚠ Mögliche Interessenkollision — bitte prüfen (§ 43a Abs. 4 BRAO)" Foreground="#f85149"
                               FontWeight="SemiBold" FontSize="{DynamicResource LwSchriftGross}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="KollisionText" Style="{StaticResource LwFliesstext}" Foreground="#e6edf3" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*" MinWidth="340"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- Stammdaten -->
                        <Border Style="{StaticResource LwKarte}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🗂 Stammdaten" Style="{StaticResource LwHeading}"/>
                                <TextBlock Style="{StaticResource LwHinweis}" Margin="0,2,0,12"
                                           Text="Aus den Dokumenten vorbelegt. Ihre Eingaben haben Vorrang."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Gericht / Behörde" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="GerichtBox" Grid.Column="1" Style="{StaticResource FormFeld}"/>
                                    <TextBlock Grid.Row="1" Text="Aktenzeichen" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="AzBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormFeld}"/>
                                    <TextBlock Grid.Row="2" Text="Gegner" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="GegnerBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FormFeld}"/>
                                    <TextBlock Grid.Row="3" Text="Gegnervertreter" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="GegnervertreterBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FormFeld}"/>
                                    <TextBlock Grid.Row="4" Text="Notiz" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,8,12,0"/>
                                    <TextBox x:Name="NotizBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource FormFeld}"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70" VerticalScrollBarVisibility="Auto"
                                             Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Beteiligte -->
                        <Border Style="{StaticResource LwKarte}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="👥 Beteiligte" Style="{StaticResource LwHeading}"/>
                                    <Border Style="{StaticResource LwZaehler}"><TextBlock x:Name="BeteiligteZahl" Style="{StaticResource LwZaehlerText}"/></Border>
                                </StackPanel>
                                <ItemsControl x:Name="BeteiligteListe" Grid.IsSharedSizeScope="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Rolle"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#21262d" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left"
                                                        VerticalAlignment="Top" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Rolle}" Style="{StaticResource LwZaehlerText}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource LwFliesstext}" Foreground="#e6edf3"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="BeteiligteLeer" Style="{StaticResource LwHinweis}"
                                           Text="Noch keine. Mit „Akte auswerten“ unten werden sie aus den Dokumenten gelesen."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Zeitleiste -->
                <Border Grid.Column="2" Style="{StaticResource LwKarte}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📅 Zeitleiste" Style="{StaticResource LwHeading}"/>
                            <Border Style="{StaticResource LwZaehler}"><TextBlock x:Name="ZeitleisteZahl" Style="{StaticResource LwZaehlerText}"/></Border>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel>
                                <ItemsControl x:Name="ZeitleisteListe" Grid.IsSharedSizeScope="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Datum"/>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DatumText}" Foreground="#e8a838" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource LwSchriftNormal}" Margin="0,0,0,14"/>
                                                <!-- Linie mit Punkt -->
                                                <Rectangle Grid.Column="1" Width="2" Fill="#30363d" HorizontalAlignment="Center"/>
                                                <Ellipse Grid.Column="1" Width="10" Height="10" Fill="#e8a838" VerticalAlignment="Top"
                                                         HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Beschreibung}" Style="{StaticResource LwFliesstext}"
                                                           Margin="6,0,0,14"/>
                                                <Button Grid.Column="3" Content="✕" Style="{StaticResource LwSmallButton}"
                                                        Padding="6,2" VerticalAlignment="Top" Click="OnZeitleisteEintragLoeschen"
                                                        ToolTip="Diesen Zeitleiste-Eintrag ausblenden (z.B. falsch zugeordnete E-Mail)"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ZeitleisteLeer" Style="{StaticResource LwHinweis}"
                                           Text="Noch keine Ereignisse. Mit „Akte auswerten“ unten entsteht die Zeitleiste aus den Dokumenten."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
