<Window x:Class="LexWolf.Dialogs.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Info"
        Icon="/Assets/lexwolf.ico"
        Width="400" Height="280"
        MinWidth="400" MinHeight="240"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Primary button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"        Value="{DynamicResource LwPrimary}"/>
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="16,8"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource LwPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource LwPrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource LwRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource LwMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="{DynamicResource LwMuted}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource LwBorder}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="16,8"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource LwRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource LwText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource LwDisabledText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="LexWolf" Foreground="#e8a838" FontSize="20" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" x:Name="VersionText" Text="Version 0.0.0"
                   Foreground="{DynamicResource LwMuted}" FontSize="13" Margin="0,4,0,20"/>

        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <TextBlock x:Name="StatusText" Text="" Foreground="{DynamicResource LwText}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="NotesText" Text="" Foreground="{DynamicResource LwMuted}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>
            <ProgressBar x:Name="UpdateProgressBar" Height="6" Margin="0,8,0,0"
                         Minimum="0" Maximum="100" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CheckBtn" Content="Auf Update prüfen"
                    Style="{StaticResource GhostBtn}" Click="OnCheckUpdate" Margin="0,0,8,0"/>
            <Button x:Name="UpdateBtn" Content="Jetzt aktualisieren"
                    Style="{StaticResource PrimaryBtn}" Click="OnApplyUpdate"
                    Visibility="Collapsed" Margin="0,0,8,0"/>
            <Button x:Name="CloseBtn" Content="Schließen"
                    Style="{StaticResource GhostBtn}" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
