<Window x:Class="LexWolf.Dialogs.GespraecheDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Gespräche"
        Icon="/Assets/lexwolf.ico"
        Width="760" Height="640" MinWidth="560" MinHeight="420"
        WindowState="Maximized"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="GespraechKarte" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource LwPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LwBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,18,24,14" BorderBrush="{DynamicResource LwBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="🎙 Gespräche" Style="{StaticResource LwDialogTitel}"/>
                <TextBlock x:Name="UntertitelText" Style="{StaticResource LwDialogUntertitel}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource LwFussleiste}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Schließen" Style="{StaticResource LwPrimaryButton}"
                        Click="OnSchliessen" IsDefault="True"/>
            </StackPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16">
                <StackPanel x:Name="GespraechePanel"/>
            </ScrollViewer>
            <TextBlock x:Name="LeerText" Style="{StaticResource LwHinweis}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Text="Noch keine Gespräche aufgezeichnet." Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
