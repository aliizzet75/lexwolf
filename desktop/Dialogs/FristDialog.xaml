<Window x:Class="LexWolf.Dialogs.FristDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Frist"
        Icon="/Assets/lexwolf.ico"
        Width="640" Height="680" MinWidth="520" MinHeight="560"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="Neue Frist" Style="{StaticResource LwHeading}" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Mandant" Style="{StaticResource LwLabel}"/>
                <ComboBox x:Name="MandantBox" Style="{StaticResource DarkComboBoxStyle}" DisplayMemberPath="Name"/>

                <TextBlock Text="Was für eine Frist?" Style="{StaticResource LwLabel}"/>
                <ComboBox x:Name="ArtBox" Style="{StaticResource DarkComboBoxStyle}" DisplayMemberPath="Anzeige"
                          SelectionChanged="OnEingabeGeaendert"/>
                <TextBlock x:Name="ArtHinweis" Foreground="{DynamicResource LwMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="Bezeichnung" Style="{StaticResource LwLabel}"/>
                <TextBox x:Name="BezeichnungBox" Style="{StaticResource LwTextBox}"/>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="EreignisPanel">
                        <TextBlock x:Name="EreignisLabel" Text="Zustellung am" Style="{StaticResource LwLabel}"/>
                        <TextBox x:Name="EreignisBox" Style="{StaticResource LwTextBox}" TextChanged="OnEingabeGeaendert"
                                 ToolTip="z. B. 14.10.2026, 14.10.26 oder 14.10."/>
                    </StackPanel>
                    <StackPanel x:Name="DatumPanel" Grid.Column="2">
                        <TextBlock Text="Frist bis (Datum)" Style="{StaticResource LwLabel}"/>
                        <TextBox x:Name="DatumBox" Style="{StaticResource LwTextBox}" TextChanged="OnEingabeGeaendert"/>
                    </StackPanel>
                    <StackPanel x:Name="DauerPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel Width="70">
                            <TextBlock Text="Dauer" Style="{StaticResource LwLabel}"/>
                            <TextBox x:Name="AnzahlBox" Style="{StaticResource LwTextBox}" Text="2" TextChanged="OnEingabeGeaendert"/>
                        </StackPanel>
                        <ComboBox x:Name="EinheitBox" Style="{StaticResource DarkComboBoxStyle}" Width="110" Margin="8,0,0,0"
                                  VerticalAlignment="Bottom" SelectionChanged="OnEingabeGeaendert">
                            <ComboBoxItem Content="Tage"/>
                            <ComboBoxItem Content="Wochen" IsSelected="True"/>
                            <ComboBoxItem Content="Monate"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource LwPanel}" BorderBrush="{DynamicResource LwBorder}" BorderThickness="1" CornerRadius="8"
                        Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="EndeText" Text="Fristende: —" Foreground="#e8a838" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RechenwegText" Foreground="{DynamicResource LwText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Vorfrist (Erinnerung)" Style="{StaticResource LwLabel}"/>
                        <TextBox x:Name="VorfristBox" Style="{StaticResource LwTextBox}"/>
                    </StackPanel>
                    <CheckBox x:Name="NotfristBox" Grid.Column="2" Content="Notfrist (nicht verlängerbar)"
                              Style="{StaticResource LwCheckBox}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                </Grid>

                <TextBlock Text="Notiz" Style="{StaticResource LwLabel}"/>
                <TextBox x:Name="NotizBox" Style="{StaticResource LwTextBox}" TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="54" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="FehlerText" Foreground="#f85149" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="320"/>
            <Button Content="Speichern" Style="{StaticResource LwPrimaryButton}" DockPanel.Dock="Right"
                    Click="OnSpeichern" IsDefault="True"/>
            <Button Content="Abbrechen" Style="{StaticResource LwButton}" DockPanel.Dock="Right" Margin="0,0,8,0"
                    IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
