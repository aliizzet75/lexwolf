<Window x:Class="LexWolf.Dialogs.VorschlaegeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Vorschläge nach dem Gespräch"
        Icon="/Assets/lexwolf.ico"
        Width="620" Height="560" MinWidth="520" MinHeight="420"
        Background="#0d1117"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- Karten-Rahmen für einen einzelnen Vorschlag. -->
        <Style x:Key="VorschlagKarte" TargetType="Border">
            <Setter Property="Background" Value="#161b22"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,18,24,14" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="💡 Vorschläge für die nächsten Schritte" Style="{StaticResource LwDialogTitel}"/>
                <TextBlock x:Name="UntertitelText" Style="{StaticResource LwDialogUntertitel}"
                           Text="Auf Basis des Gesprächs — bitte je Vorschlag entscheiden."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource LwFussleiste}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="FertigBtn" Content="Fertig" Style="{StaticResource LwPrimaryButton}"
                        Click="OnFertig" IsDefault="True"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16">
            <StackPanel x:Name="VorschlaegePanel"/>
        </ScrollViewer>
    </DockPanel>
</Window>
