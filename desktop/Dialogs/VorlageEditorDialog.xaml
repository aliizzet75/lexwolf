<Window x:Class="LexWolf.Dialogs.VorlageEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Vorlage bearbeiten"
        Icon="/Assets/lexwolf.ico"
        Width="900" Height="700" MinWidth="520" MinHeight="400"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <DockPanel>
        <!-- Kopf -->
        <Border DockPanel.Dock="Top" Padding="24,18,24,14" BorderBrush="{DynamicResource LwBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Vorlage bearbeiten" Style="{StaticResource LwDialogTitel}"/>
                <TextBlock x:Name="UntertitelText" Style="{StaticResource LwDialogUntertitel}"/>
            </StackPanel>
        </Border>

        <!-- Fuß -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource LwFussleiste}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SpeichernBtn" Content="💾 Speichern" Style="{StaticResource LwPrimaryButton}"
                            Click="OnSpeichern" ToolTip="Schreibt die Vorlagen-Datei zurück"/>
                    <Button Content="Schließen" Style="{StaticResource LwButton}" Margin="8,0,0,0"
                            IsCancel="True" Click="OnSchliessen"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource LwStatus}"/>
            </DockPanel>
        </Border>

        <TextBox x:Name="InhaltBox" Style="{StaticResource LwEditor}" FontFamily="Segoe UI" Margin="24,16"
                 TextChanged="OnInhaltGeaendert"/>
    </DockPanel>
</Window>
