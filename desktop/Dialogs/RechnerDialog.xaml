<Window x:Class="LexWolf.Dialogs.RechnerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Rechner"
        Icon="/Assets/lexwolf.ico"
        Width="1160" Height="820" MinWidth="900" MinHeight="580"
        Background="#0d1117"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="Zahl" TargetType="TextBox" BasedOn="{StaticResource LwTextBox}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Karte" TargetType="Border" BasedOn="{StaticResource LwKarte}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Einrueckung" TargetType="StackPanel">
            <Setter Property="Margin" Value="28,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Kopf -->
        <Border DockPanel.Dock="Top" Padding="24,18,24,14" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="⚙ Tabellenwerte" Style="{StaticResource LwSmallButton}" VerticalAlignment="Top"
                        Click="OnWerteBearbeiten" ToolTip="Düsseldorfer Tabelle, Kindergeld, Selbstbehalte, RVG-Tabelle anpassen"/>
                <StackPanel>
                    <TextBlock Text="Rechner" Style="{StaticResource LwDialogTitel}"/>
                    <TextBlock x:Name="UntertitelText" Style="{StaticResource LwDialogUntertitel}" Visibility="Collapsed"/>
                    <TextBlock x:Name="StandText" Style="{StaticResource LwHinweis}" Margin="0,4,0,0"/>
                    <WrapPanel x:Name="Legende" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Style="{StaticResource LwLegendeFeld}" Background="{StaticResource LwHerkunftLexWolfHintergrund}"
                                    BorderBrush="{StaticResource LwHerkunftLexWolf}"/>
                            <TextBlock Style="{StaticResource LwHinweis}" Foreground="{StaticResource LwHerkunftLexWolfText}"
                                       Text="von LexWolf aus der Akte — bitte prüfen" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource LwLegendeFeld}" Background="{StaticResource LwHerkunftAnwaltHintergrund}"
                                    BorderBrush="{StaticResource LwHerkunftAnwalt}"/>
                            <TextBlock Style="{StaticResource LwHinweis}" Foreground="{StaticResource LwHerkunftAnwaltText}"
                                       Text="von Ihnen eingegeben" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Fuß -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource LwFussleiste}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AusfuellenBtn" Content="✨ LexWolf ausfüllen" Style="{StaticResource LwButton}" Click="OnLexWolfAusfuellen"
                            Margin="0,0,8,0" Visibility="Collapsed"
                            ToolTip="Akte neu lesen und geleerte Felder wieder mit den Werten aus den Dokumenten füllen. Ihre Eingaben bleiben."/>
                    <Button Content="📋 Kopieren" Style="{StaticResource LwButton}" Click="OnKopieren"
                            ToolTip="Ergebnis und Rechenweg in die Zwischenablage"/>
                    <Button x:Name="UebernehmenBtn" Content="💬 In den Chat übernehmen" Style="{StaticResource LwPrimaryButton}"
                            Margin="8,0,0,0" Click="OnInChat"/>
                    <Button Content="Schließen" Style="{StaticResource LwButton}" Margin="8,0,0,0" IsCancel="True" Click="OnSchliessen"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource LwStatus}"/>
            </DockPanel>
        </Border>

        <Grid Margin="24,12,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="440"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="4*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="Tabs" Style="{StaticResource LwTabControl}" SelectionChanged="OnTabGewechselt">
                <!-- Unterhalt -->
                <TabItem Header="Unterhalt">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                        <StackPanel>
                            <Border Style="{StaticResource Karte}">
                                <StackPanel>
                                    <TextBlock Text="Unterhaltspflichtiger" Style="{StaticResource LwHeading}"/>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="Nettoeinkommen / Monat" Style="{StaticResource LwLabel}"/>
                                            <TextBox x:Name="UNetto" Style="{StaticResource Zahl}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="Sonstige Abzüge / Monat" Style="{StaticResource LwLabel}"
                                                       ToolTip="Schulden, Altersvorsorge …"/>
                                            <TextBox x:Name="UAbzug" Style="{StaticResource Zahl}" Text="0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Stichtag" Style="{StaticResource LwLabel}"/>
                                            <TextBox x:Name="UStichtag" Style="{StaticResource Zahl}" HorizontalContentAlignment="Left"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <CheckBox x:Name="UErwerb" Content="erwerbstätig" Style="{StaticResource LwCheckBox}" IsChecked="True"
                                              Margin="0,10,0,0" ToolTip="5 % berufsbedingte Aufwendungen, Selbstbehalt für Erwerbstätige"/>
                                    <TextBlock Text="Höher-/Herabstufung" Style="{StaticResource LwLabel}"
                                               ToolTip="Die Tabelle geht von 2 Unterhaltsberechtigten aus"/>
                                    <ComboBox x:Name="UStufung" Style="{StaticResource DarkComboBoxStyle}" MinWidth="200" HorizontalAlignment="Left"
                                              SelectionChanged="OnNeuRechnen">
                                        <ComboBoxItem Content="−2 Gruppen" Tag="-2"/>
                                        <ComboBoxItem Content="−1 Gruppe" Tag="-1"/>
                                        <ComboBoxItem Content="keine" Tag="0" IsSelected="True"/>
                                        <ComboBoxItem Content="+1 Gruppe" Tag="1"/>
                                        <ComboBoxItem Content="+2 Gruppen" Tag="2"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Karte}">
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="+ Kind" Style="{StaticResource LwSmallButton}" Click="OnKindNeu"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Kinder" Style="{StaticResource LwHeading}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="KinderHerkunft" Style="{StaticResource LwHinweis}" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="KindHaken"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="KindEntfernen"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Name" Style="{StaticResource LwZaehlerText}"/>
                                        <TextBlock Grid.Column="1" Text="Geburtsdatum" Style="{StaticResource LwZaehlerText}" Margin="8,0,0,0"/>
                                    </Grid>
                                    <ItemsControl x:Name="KinderListe">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="KindHaken"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="KindEntfernen"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LwTextBox}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Geburt, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource LwTextBox}" Margin="8,0,0,0" ToolTip="z. B. 03.05.2015"/>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding EigenerHausstand}" Content="eigener Haushalt"
                                                              Style="{StaticResource LwCheckBox}" Margin="10,0,0,0"
                                                              ToolTip="Nur volljährige Kinder: fester Bedarf statt Tabellenbetrag"/>
                                                    <Button Grid.Column="3" Content="✕" Style="{StaticResource LwSmallButton}" Margin="8,0,0,0"
                                                            Click="OnKindEntfernen" Tag="{Binding}" ToolTip="Kind entfernen"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Karte}">
                                <StackPanel>
                                    <CheckBox x:Name="UEhegatte" Style="{StaticResource LwCheckBox}" Margin="0">
                                        <TextBlock Text="Ehegattenunterhalt mitberechnen" Style="{StaticResource LwHeading}"/>
                                    </CheckBox>
                                    <StackPanel x:Name="UEhegattePanel" Style="{StaticResource Einrueckung}">
                                        <TextBlock Text="Nettoeinkommen des Berechtigten / Monat" Style="{StaticResource LwLabel}"/>
                                        <TextBox x:Name="UNettoBerechtigt" Style="{StaticResource Zahl}" Text="0"/>
                                        <CheckBox x:Name="UBerechtigtErwerb" Content="Berechtigter ist erwerbstätig" Style="{StaticResource LwCheckBox}"
                                                  IsChecked="True" Margin="0,8,0,0"/>
                                        <CheckBox x:Name="USuedL" Content="Süddeutsche Leitlinien (45 % statt 3/7)" Style="{StaticResource LwCheckBox}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Zugewinn -->
                <TabItem Header="Zugewinn">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Karte}">
                                    <StackPanel>
                                        <TextBlock Text="Mandant" Style="{StaticResource LwHeading}"/>
                                        <TextBlock Text="Anfangsvermögen" Style="{StaticResource LwLabel}"/>
                                        <TextBox x:Name="ZAnfangM" Style="{StaticResource Zahl}" Text="0"/>
                                        <TextBlock Text="Erbe / Schenkung" Style="{StaticResource LwLabel}" ToolTip="Privilegierter Erwerb (§ 1374 Abs. 2 BGB)"/>
                                        <TextBox x:Name="ZPrivM" Style="{StaticResource Zahl}" Text="0"/>
                                        <TextBlock Text="Endvermögen" Style="{StaticResource LwLabel}"/>
                                        <TextBox x:Name="ZEndeM" Style="{StaticResource Zahl}" Text="0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Karte}">
                                    <StackPanel>
                                        <TextBlock Text="Gegenseite" Style="{StaticResource LwHeading}"/>
                                        <TextBlock Text="Anfangsvermögen" Style="{StaticResource LwLabel}"/>
                                        <TextBox x:Name="ZAnfangG" Style="{StaticResource Zahl}" Text="0"/>
                                        <TextBlock Text="Erbe / Schenkung" Style="{StaticResource LwLabel}" ToolTip="Privilegierter Erwerb (§ 1374 Abs. 2 BGB)"/>
                                        <TextBox x:Name="ZPrivG" Style="{StaticResource Zahl}" Text="0"/>
                                        <TextBlock Text="Endvermögen" Style="{StaticResource LwLabel}"/>
                                        <TextBox x:Name="ZEndeG" Style="{StaticResource Zahl}" Text="0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Karte}">
                                <StackPanel>
                                    <TextBlock Text="Indexierung" Style="{StaticResource LwHeading}"/>
                                    <TextBlock Text="Faktor VPI Ende ÷ VPI Beginn (1 = ohne)" Style="{StaticResource LwLabel}"/>
                                    <TextBox x:Name="ZIndex" Style="{StaticResource Zahl}" Text="1"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Verfahrenswert -->
                <TabItem Header="Verfahrenswert">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                        <StackPanel>
                            <Border Style="{StaticResource Karte}">
                                <StackPanel>
                                    <CheckBox x:Name="VScheidung" Content="Scheidung (§ 43 FamGKG)" Style="{StaticResource LwCheckBox}" IsChecked="True" Margin="0"/>
                                    <WrapPanel Margin="28,0,0,0">
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="Netto beider Ehegatten / Monat" Style="{StaticResource LwLabel}"/>
                                            <TextBox x:Name="VNetto" Style="{StaticResource Zahl}" Text="0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Abzug für Kinder / Monat" Style="{StaticResource LwLabel}"/>
                                            <TextBox x:Name="VKinderAbzug" Style="{StaticResource Zahl}" Text="0"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Karte}">
                                <StackPanel>
                                    <CheckBox x:Name="VVa" Content="Versorgungsausgleich (§ 50 FamGKG)" Style="{StaticResource LwCheckBox}" Margin="0"/>
                                    <StackPanel Style="{StaticResource Einrueckung}">
                                        <TextBlock Text="Anzahl Anrechte (beide Ehegatten)" Style="{StaticResource LwLabel}"/>
                                        <TextBox x:Name="VAnrechte" Style="{StaticResource Zahl}" Text="2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Karte}">
                                <StackPanel>
                                    <CheckBox x:Name="VUnterhalt" Content="Unterhalt (§ 51 FamGKG)" Style="{StaticResource LwCheckBox}" Margin="0"/>
                                    <WrapPanel Margin="28,0,0,0">
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="Monatsbetrag" Style="{StaticResource LwLabel}"/>
                                            <TextBox x:Name="VUMonat" Style="{StaticResource Zahl}" Text="0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Rückstand bei Einreichung" Style="{StaticResource LwLabel}"/>
                                            <TextBox x:Name="VURueck" Style="{StaticResource Zahl}" Text="0"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Karte}">
                                <StackPanel>
                                    <CheckBox x:Name="VZugewinn" Content="Zugewinn" Style="{StaticResource LwCheckBox}" Margin="0"/>
                                    <StackPanel Style="{StaticResource Einrueckung}">
                                        <TextBlock Text="Höhe der Forderung" Style="{StaticResource LwLabel}"/>
                                        <TextBox x:Name="VZForderung" Style="{StaticResource Zahl}" Text="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Karte}">
                                <CheckBox x:Name="VSorge" Content="Sorge- / Umgangsrecht (§ 45 FamGKG)" Style="{StaticResource LwCheckBox}" Margin="0"/>
                            </Border>
                            <Button Content="→ Gesamtwert in den RVG-Rechner" Style="{StaticResource LwButton}" HorizontalAlignment="Left"
                                    Margin="0,0,0,12" Click="OnWertZuRvg"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- RVG / Kosten -->
                <TabItem Header="RVG / Kosten">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                        <StackPanel>
                            <Border Style="{StaticResource Karte}">
                                <StackPanel>
                                    <TextBlock Text="Gegenstands- / Verfahrenswert" Style="{StaticResource LwHeading}"/>
                                    <TextBox x:Name="RWert" Style="{StaticResource Zahl}" Text="5000" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Karte}">
                                <StackPanel>
                                    <TextBlock Text="Gebühren" Style="{StaticResource LwHeading}" Margin="0,0,0,6"/>
                                    <ItemsControl x:Name="RTatbestaende">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Aktiv}" Style="{StaticResource LwCheckBox}" Content="{Binding Anzeige}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <CheckBox x:Name="RPauschale" Content="Post- und Telekommunikationspauschale (VV 7002)" Style="{StaticResource LwCheckBox}"
                                              IsChecked="True" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Karte}">
                                <StackPanel>
                                    <CheckBox x:Name="RRisiko" Style="{StaticResource LwCheckBox}" IsChecked="True" Margin="0">
                                        <TextBlock Text="Kostenrisiko zeigen" Style="{StaticResource LwHeading}"/>
                                    </CheckBox>
                                    <StackPanel Style="{StaticResource Einrueckung}">
                                        <TextBlock Style="{StaticResource LwHinweis}" Text="Gegnerische Anwaltskosten und Gerichtskosten." Margin="0,2,0,0"/>
                                        <TextBlock Text="Gerichtliches Verfahren" Style="{StaticResource LwLabel}"/>
                                        <ComboBox x:Name="RVerfahren" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="OnNeuRechnen"/>
                                        <CheckBox x:Name="RErmaessigt" Content="Endet durch Vergleich oder Rücknahme (ermäßigt)"
                                                  Style="{StaticResource LwCheckBox}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Rechts: Ergebnis und Rechenweg -->
            <DockPanel Grid.Column="2" Margin="0,4,0,0">
                <Border DockPanel.Dock="Top" Background="#1f1a10" BorderBrush="#e8a838" BorderThickness="1" CornerRadius="8"
                        Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Ergebnis" Style="{StaticResource LwZaehlerText}"/>
                        <TextBlock x:Name="ErgebnisText" Foreground="#e8a838" FontSize="{DynamicResource LwSchriftTitel}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Text="—" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource LwKarte}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Rechenweg" Style="{StaticResource LwHeading}" Margin="16,12,16,4"/>
                        <TextBox x:Name="RechenwegBox" Style="{StaticResource LwTextBox}" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" BorderThickness="0"
                                 Background="Transparent" Padding="16,4,16,12"/>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
