<Window x:Class="LexWolf.Dialogs.ZusammenfassungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Mandanten-Zusammenfassung"
        Icon="/Assets/lexwolf.ico"
        Width="780" Height="520"
        MinWidth="560" MinHeight="360"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   Text="Zusammenfassung"
                   Foreground="{DynamicResource LwTextStrong}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                Background="{DynamicResource LwPanel}"
                BorderBrush="{DynamicResource LwBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ZusammenfassungText"
                           Text=""
                           Foreground="{DynamicResource LwText}"
                           FontSize="13"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                Content="Schließen"
                Click="OnCloseClick"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Background="{DynamicResource LwRaised}"
                Foreground="{DynamicResource LwText}"
                BorderBrush="{DynamicResource LwBorder}"
                BorderThickness="1"
                Padding="16,7"
                Cursor="Hand"/>
    </Grid>
</Window>
