<Window x:Class="LexWolf.Dialogs.UmbenennenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Umbenennen"
        Icon="/Assets/lexwolf.ico"
        Width="440" MinWidth="380" SizeToContent="Height"
        Background="#0d1117"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,18,24,14" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="TitelText" Text="✏️ Umbenennen" Style="{StaticResource LwDialogTitel}"/>
                <TextBlock x:Name="UntertitelText" Style="{StaticResource LwDialogUntertitel}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource LwFussleiste}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Style="{StaticResource LwButton}" IsCancel="True"/>
                <Button x:Name="UmbenennenBtn" Content="Umbenennen" Style="{StaticResource LwPrimaryButton}"
                        Margin="8,0,0,0" IsEnabled="False" Click="OnUmbenennen"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,16,24,8">
            <TextBlock Text="Neuer Name" Style="{StaticResource LwLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource LwTextBox}" TextChanged="OnNameGeaendert"/>
            <TextBlock x:Name="FehlerText" Foreground="#f85149" FontSize="11" TextWrapping="Wrap"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</Window>
