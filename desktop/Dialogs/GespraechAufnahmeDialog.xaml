<Window x:Class="LexWolf.Dialogs.GespraechAufnahmeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Gespräch wird aufgenommen"
        Icon="/Assets/lexwolf.ico"
        Width="360" Height="420"
        MinWidth="360" MinHeight="420"
        Background="#0d1117"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="StopBtn" TargetType="Button">
            <Setter Property="Background"      Value="#f85149"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="28"
                                Padding="20,14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ff6b63"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#da3832"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🎙 Gespräch wird aufgenommen" Foreground="#e8a838"
                   FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>

        <Viewbox Grid.Row="1" Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="WolfBild" Source="/Assets/lexwolf.ico" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="WolfScale" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Image.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="WolfScale" Storyboard.TargetProperty="ScaleX"
                                                  From="1.0" To="1.14" Duration="0:0:0.9">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="WolfScale" Storyboard.TargetProperty="ScaleY"
                                                  From="1.0" To="1.14" Duration="0:0:0.9">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
        </Viewbox>

        <TextBlock Grid.Row="2" x:Name="ZeitText" Text="00:00" Foreground="#e6edf3"
                   FontSize="36" FontWeight="Bold" FontFamily="Consolas"
                   HorizontalAlignment="Center" Margin="0,4,0,4"/>

        <TextBlock Grid.Row="3" Text="Audio verlässt nie diesen Rechner." Foreground="#8b949e"
                   FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,18"/>

        <Button Grid.Row="4" Content="⏹ Aufnahme beenden" Style="{StaticResource StopBtn}"
                Click="OnStop" HorizontalAlignment="Center"/>
    </Grid>
</Window>
