<Window x:Class="LexWolf.Dialogs.MandantLoeschenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Mandant löschen"
        Icon="/Assets/lexwolf.ico"
        Width="680" Height="640" MinWidth="520" MinHeight="460"
        Background="#0d1117"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <DockPanel>
        <!-- Kopf -->
        <Border DockPanel.Dock="Top" Padding="24,18,24,14" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="🗑 Mandant löschen" Style="{StaticResource LwDialogTitel}" Foreground="#f85149"/>
                <TextBlock x:Name="UntertitelText" Style="{StaticResource LwDialogUntertitel}"/>
            </StackPanel>
        </Border>

        <!-- Fuß -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource LwFussleiste}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Style="{StaticResource LwButton}" IsCancel="True" IsDefault="True"/>
                <Button x:Name="LoeschenBtn" Content="Endgültig löschen" Style="{StaticResource LwGefahrButton}"
                        Margin="8,0,0,0" Padding="18,7" IsEnabled="False" Click="OnLoeschen"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,18,8">
            <StackPanel>
                <TextBlock Style="{StaticResource LwFliesstext}" Foreground="#e6edf3" Margin="0,0,0,12"
                           Text="Folgendes wird gelöscht:"/>
                <Border Style="{StaticResource LwKarte}">
                    <ItemsControl x:Name="UmfangListe">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Symbol}" MinWidth="32" FontSize="{DynamicResource LwSchriftGross}"/>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource LwFliesstext}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Offene Fristen -->
                <Border x:Name="FristWarnung" Background="#2d1416" BorderBrush="#f85149" BorderThickness="1" CornerRadius="8"
                        Padding="16,12" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="FristWarnungText" Style="{StaticResource LwFliesstext}" Foreground="#ffb3ad"/>
                </Border>

                <Border Background="#1f1a10" BorderBrush="#c48f2c" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource LwHinweis}" Foreground="#e8c27a"
                               Text="Handakten sind grundsätzlich 6 Jahre nach Ende des Auftrags aufzubewahren (§ 50 Abs. 1 BRAO). Löschen Sie nur, wenn die Frist abgelaufen ist oder der Mandant versehentlich angelegt wurde."/>
                </Border>

                <TextBlock x:Name="PapierkorbHinweis" Style="{StaticResource LwHinweis}" Margin="0,12,0,0"
                           Text="Die Dateien des Aktenordners kommen in den Windows-Papierkorb und lassen sich von dort wiederherstellen. Fristen, Chat, Notizen und Auswertungen in LexWolf sind danach endgültig gelöscht."/>

                <TextBlock x:Name="BestaetigungLabel" Style="{StaticResource LwLabel}" Margin="0,16,0,4"/>
                <TextBox x:Name="BestaetigungBox" Style="{StaticResource LwTextBox}" TextChanged="OnBestaetigungGeaendert"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
