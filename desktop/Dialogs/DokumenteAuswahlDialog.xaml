<Window x:Class="LexWolf.Dialogs.DokumenteAuswahlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dokumente für diese Frage auswählen"
        Icon="/Assets/lexwolf.ico"
        Width="560" Height="480" MinWidth="420" MinHeight="320"
        Background="#0d1117"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="LwHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="LwHinweis" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8b949e"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LwCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="LwButton" TargetType="Button">
            <Setter Property="Background" Value="#21262d"/>
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="LwSmallButton" TargetType="Button" BasedOn="{StaticResource LwButton}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Border Padding="16" Background="#0d1117">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource LwHeading}"
                       Text="📎 Welche Dokumente sollen für diese Chat-Frage berücksichtigt werden?"/>

            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Alle/Keine" Style="{StaticResource LwSmallButton}"
                        Click="OnAlleUmschalten"/>
                <TextBlock x:Name="ZaehlerText" Style="{StaticResource LwHinweis}" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" Padding="10,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="DokumenteListe">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Content="👁" Style="{StaticResource LwSmallButton}"
                                                Padding="6,2" Margin="6,0,0,0" Click="OnDokumentOeffnen"
                                                ToolTip="Dokument öffnen"/>
                                        <CheckBox IsChecked="{Binding Ausgewaehlt}" Style="{StaticResource LwCheckBox}"
                                                  VerticalContentAlignment="Top" Click="OnDokumentGeaendert">
                                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                                <TextBlock FontSize="12" Foreground="#c9d1d9" Text="{Binding Titel}"/>
                                                <TextBlock FontSize="12" Foreground="#8b949e" FontStyle="Italic"
                                                           Text=" — Vorlage"
                                                           Visibility="{Binding IstVorlage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="LeerText" Style="{StaticResource LwHinweis}" Visibility="Collapsed"
                                   Text="Keine lesbaren Dokumente in der Akte vorhanden."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="3" Style="{StaticResource LwHinweis}" Margin="0,8,0,8"
                       Text="Die Auswahl ergänzt die automatische Chat-Kontext-Bildung und die per Rechtsklick priorisierten Dokumente."/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Style="{StaticResource LwButton}" Width="90" IsDefault="True" Click="OnOk"/>
                <Button Content="Abbrechen" Style="{StaticResource LwButton}" Width="90" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
