<Window x:Class="LexWolf.Dialogs.RechercheErgebnisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Recherche-Ergebnis"
        Icon="/Assets/lexwolf.ico"
        Width="760" Height="640"
        MinWidth="520" MinHeight="360"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🔎 Recherche-Ergebnis" Foreground="{DynamicResource LwTextStrong}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Suchschritte, Status/Confidence und der anonymisiert an den Server gesendete Text."
                       Foreground="{DynamicResource LwMuted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource LwPanel}" BorderBrush="{DynamicResource LwBorder}" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource LwText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource LwPanel}" BorderBrush="{DynamicResource LwBorder}" BorderThickness="1"
                CornerRadius="8">
            <wpf:WebView2 x:Name="WebView"
                xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                Margin="0"/>
        </Border>

        <Button Grid.Row="3" x:Name="CloseBtn" Content="Schließen"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="Transparent" Foreground="{DynamicResource LwMuted}"
                BorderBrush="{DynamicResource LwBorder}" BorderThickness="1" Padding="16,8"
                Cursor="Hand" Click="OnClose"/>
    </Grid>
</Window>
