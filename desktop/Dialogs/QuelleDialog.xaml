<Window x:Class="LexWolf.Dialogs.QuelleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Quelle"
        Icon="/Assets/lexwolf.ico"
        Width="640" Height="520"
        MinWidth="420" MinHeight="300"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitelText" Text="Quelle" Foreground="#e8a838"
                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBox Grid.Row="1" x:Name="TextBox" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" FontSize="13"
                 Background="{DynamicResource LwPanel}" Foreground="{DynamicResource LwText}" BorderBrush="{DynamicResource LwBorder}"
                 BorderThickness="1" Padding="10"
                 SelectionBrush="{DynamicResource LwPrimary}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

        <Button Grid.Row="2" x:Name="CloseBtn" Content="Schließen"
                HorizontalAlignment="Right" Margin="0,16,0,0"
                Background="Transparent" Foreground="{DynamicResource LwMuted}"
                BorderBrush="{DynamicResource LwBorder}" BorderThickness="1" Padding="16,8"
                Cursor="Hand" Click="OnClose"/>
    </Grid>
</Window>
