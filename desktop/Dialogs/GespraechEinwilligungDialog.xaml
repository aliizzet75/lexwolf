<Window x:Class="LexWolf.Dialogs.GespraechEinwilligungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — Einwilligung zur Gesprächsaufzeichnung"
        Icon="/Assets/lexwolf.ico"
        Width="520" Height="320" MinWidth="440" MinHeight="280"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,18,24,14" BorderBrush="{DynamicResource LwBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="🔒 Einwilligung zur Gesprächsaufzeichnung" Style="{StaticResource LwDialogTitel}"/>
                <TextBlock x:Name="UntertitelText" Style="{StaticResource LwDialogUntertitel}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource LwFussleiste}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NeinBtn" Content="Nein" Style="{StaticResource LwButton}"
                        IsCancel="True" Click="OnNein"/>
                <Button x:Name="JaBtn" Content="Ja, einverstanden" Style="{StaticResource LwPrimaryButton}"
                        Margin="8,0,0,0" Click="OnJa" IsDefault="True"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,16,24,8">
            <TextBlock x:Name="HinweisText" Style="{StaticResource LwFliesstext}" Foreground="{DynamicResource LwTextStrong}" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
