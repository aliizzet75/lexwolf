<Window x:Class="LexWolf.Dialogs.PostfachDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexWolf — E-Mail-Postfach verbinden"
        Icon="/Assets/lexwolf.ico"
        Width="560" Height="640" MinWidth="480" MinHeight="560"
        Background="{DynamicResource LwBg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="E-Mail-Postfach verbinden" Style="{StaticResource LwHeading}"/>
            <TextBlock Foreground="{DynamicResource LwMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="LexWolf ruft neue Mails regelmäßig ab, ordnet sie dem passenden Mandanten zu (Aktenzeichen, Namen, bekannte Absender) und legt sie mit Anhängen in der Akte ab. Im Postfach wird nichts verändert — Mails werden nur gelesen."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Anbieter (füllt Server und Port vor)" Style="{StaticResource LwLabel}"/>
                <ComboBox x:Name="AnbieterBox" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="OnAnbieter"/>
                <TextBlock Text="IMAP-Server" Style="{StaticResource LwLabel}"/>
                <TextBox x:Name="ServerBox" Style="{StaticResource LwTextBox}" ToolTip="z. B. imap.ionos.de"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="100">
                        <TextBlock Text="Port" Style="{StaticResource LwLabel}"/>
                        <TextBox x:Name="PortBox" Style="{StaticResource LwTextBox}" Text="993"/>
                    </StackPanel>
                    <CheckBox x:Name="SslBox" Content="SSL/TLS (empfohlen)" Style="{StaticResource LwCheckBox}" IsChecked="True"
                              VerticalAlignment="Bottom" Margin="14,0,0,6"/>
                </StackPanel>
                <TextBlock Text="Benutzername (meist die E-Mail-Adresse)" Style="{StaticResource LwLabel}"/>
                <TextBox x:Name="BenutzerBox" Style="{StaticResource LwTextBox}"/>
                <TextBlock Text="Passwort" Style="{StaticResource LwLabel}"/>
                <PasswordBox x:Name="PasswortBox" Background="{DynamicResource LwBg}" Foreground="{DynamicResource LwText}" BorderBrush="{DynamicResource LwBorder}"
                             BorderThickness="1" Padding="6,4" FontSize="12"/>
                <TextBlock x:Name="PasswortHinweis" Foreground="{DynamicResource LwMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Wird verschlüsselt nur für Ihren Windows-Benutzer gespeichert. Leer lassen = bisheriges Passwort behalten."/>
                <TextBlock Text="Ordner" Style="{StaticResource LwLabel}"/>
                <TextBox x:Name="OrdnerBox" Style="{StaticResource LwTextBox}" Text="INBOX"/>
                <TextBlock Text="Abruf alle … Minuten" Style="{StaticResource LwLabel}"/>
                <TextBox x:Name="MinutenBox" Style="{StaticResource LwTextBox}" Width="80" HorizontalAlignment="Left" Text="5"/>
                <CheckBox x:Name="AktivBox" Content="Postfach automatisch abrufen" Style="{StaticResource LwCheckBox}"
                          IsChecked="True" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource LwMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestBtn" Content="Verbindung testen" Style="{StaticResource LwButton}" Click="OnTesten"/>
                <Button Content="Speichern" Style="{StaticResource LwPrimaryButton}" Margin="8,0,0,0" Click="OnSpeichern" IsDefault="True"/>
                <Button Content="Abbrechen" Style="{StaticResource LwButton}" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
