<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bewusst plattformunabhängig (net10.0, kein -windows-Suffix) — läuft auch
       unter Linux/CI, im Gegensatz zum Hauptprojekt (net10.0-windows10.0.19041.0,
       wegen WinRT-OCR-APIs nur unter Windows lauffähig). Testet nur die reine
       PdfPig-Extraktion (PdfTextExtractor), nicht den OCR-Fallback. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Services/PdfTextExtractor.cs" Link="PdfTextExtractor.cs" />
    <Compile Include="../Database/LocalDb.cs" Link="LocalDb.cs" />
    <Compile Include="../Services/ChatHtmlRenderer.cs" Link="ChatHtmlRenderer.cs" />
    <Compile Include="../Services/FeatureNotificationStore.cs" Link="FeatureNotificationStore.cs" />
    <Compile Include="../Services/ScreenshotValidator.cs" Link="ScreenshotValidator.cs" />
    <Compile Include="../Services/MandantFilter.cs" Link="MandantFilter.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../test/*.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
