<UserControl x:Class="LexWolf.Controls.FristenPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LexWolf.Controls">
    <UserControl.Resources>
        <!-- Überschrift einer Gruppe (Überfällig, Heute, …) -->
        <DataTemplate DataType="{x:Type local:FristGruppe}">
            <TextBlock Text="{Binding Titel}" Foreground="{Binding Farbe}" FontSize="11" FontWeight="SemiBold"
                       Margin="2,10,0,2"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:FristZeile}">
            <Border Background="#0d1117" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6"
                    Cursor="Hand" MouseLeftButtonUp="OnZeileClick" Tag="{Binding}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="6,0,0,6" Background="{Binding Farbe}"/>
                    <StackPanel Margin="10,8,10,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="NOTFRIST" Foreground="#f85149" FontSize="9"
                                       FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding NotfristSichtbar}"/>
                            <TextBlock Text="{Binding Bezeichnung}" Foreground="#e6edf3" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Mandant}" Foreground="#8b949e" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap">
                            <Run Text="{Binding EndeText, Mode=OneWay}" Foreground="#c9d1d9"/>
                            <Run Text="{Binding Abstand, Mode=OneWay}" Foreground="{Binding Farbe}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding VorfristText}" Foreground="#8b949e" FontSize="11"/>
                        <TextBlock Text="{Binding Hinweis}" Foreground="#d29922" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding HinweisSichtbar}" Margin="0,3,0,0"/>

                        <!-- Vorschlag: übernehmen / prüfen / verwerfen -->
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Visibility="{Binding VorschlagSichtbar}">
                            <Button Content="✓ Übernehmen" Style="{StaticResource LwSmallButton}" Click="OnUebernehmen"
                                    Tag="{Binding}" Background="#238636" Foreground="White" BorderBrush="#2ea043"
                                    ToolTip="Frist wie berechnet als offene Frist übernehmen"/>
                            <Button Content="✎ Prüfen" Style="{StaticResource LwSmallButton}" Click="OnBearbeiten"
                                    Tag="{Binding}" Margin="6,0,0,0" ToolTip="Datum und Fristart prüfen, dann übernehmen"/>
                            <Button Content="✕" Style="{StaticResource LwSmallButton}" Click="OnVerwerfen"
                                    Tag="{Binding}" Margin="6,0,0,0" ToolTip="Vorschlag verwerfen"/>
                        </StackPanel>
                        <!-- Offene Frist: erledigt / bearbeiten / Kalender -->
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Visibility="{Binding OffenSichtbar}">
                            <Button Content="✓ Erledigt" Style="{StaticResource LwSmallButton}" Click="OnErledigt" Tag="{Binding}"/>
                            <Button Content="✎" Style="{StaticResource LwSmallButton}" Click="OnBearbeiten" Tag="{Binding}"
                                    Margin="6,0,0,0" ToolTip="Bearbeiten"/>
                            <Button Content="📅 Outlook" Style="{StaticResource LwSmallButton}" Click="OnKalender" Tag="{Binding}"
                                    Margin="6,0,0,0" ToolTip="Fristende und Vorfrist in den Kalender übernehmen"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="+ Neue Frist" Style="{StaticResource LwPrimaryButton}"
                            Padding="10,4" Click="OnNeu"/>
                    <Button DockPanel.Dock="Right" Content="🖨" Style="{StaticResource LwSmallButton}"
                            Margin="0,0,6,0" Click="OnDrucken"
                            ToolTip="Fristenliste der nächsten 14 Tage drucken (tägliche Fristenkontrolle)"/>
                    <TextBlock x:Name="ZusammenfassungText" Foreground="#c9d1d9" FontSize="12" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <CheckBox x:Name="NurMandantBox" Content="Nur aktueller Mandant" Style="{StaticResource LwCheckBox}"
                              DockPanel.Dock="Left" Checked="OnFilterGeaendert" Unchecked="OnFilterGeaendert"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,8">
            <StackPanel>
                <ItemsControl x:Name="Liste"/>
                <TextBlock x:Name="LeerText" Foreground="#8b949e" FontSize="12" TextWrapping="Wrap" Margin="2,16,2,0"
                           Text="Keine offenen Fristen. LexWolf schlägt Fristen automatisch vor, sobald ein Urteil, Beschluss oder eine gerichtliche Verfügung im Mandantenordner landet — oder legen Sie mit „+ Neue Frist“ selbst eine an."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
