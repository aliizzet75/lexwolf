<UserControl x:Class="LexWolf.Controls.EingangPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LexWolf.Controls">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type local:EingangZeile}">
            <Border Background="#0d1117" BorderBrush="{Binding Rahmen}" BorderThickness="1" CornerRadius="6"
                    Opacity="{Binding Deckkraft}">
                <StackPanel Margin="10,8,10,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontSize="15" Margin="0,0,7,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="EILIG" Foreground="#f85149" FontSize="9" FontWeight="Bold"
                                   VerticalAlignment="Center" Visibility="{Binding EiligSichtbar}"/>
                        <TextBlock Text="{Binding Titel}" Foreground="#e6edf3" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Meta}" Foreground="#8b949e" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Zusammenfassung}" Foreground="#c9d1d9" FontSize="12" TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Anliegen}" Foreground="#c9d1d9" FontSize="12" TextWrapping="Wrap"
                               Margin="0,4,0,0" Visibility="{Binding AnliegenSichtbar}"/>
                    <TextBlock Text="{Binding NaechsterSchritt}" Foreground="#e8a838" FontSize="12" TextWrapping="Wrap"
                               Margin="0,4,0,0" Visibility="{Binding SchrittSichtbar}"/>
                    <TextBlock Text="{Binding FristenText}" Foreground="#58a6ff" FontSize="11" TextWrapping="Wrap"
                               Margin="0,4,0,0" Visibility="{Binding FristenSichtbar}"/>
                    <WrapPanel Margin="0,7,0,0">
                        <Button Content="💬 Antwort entwerfen" Style="{StaticResource LwSmallButton}" Click="OnAntwort"
                                Tag="{Binding}" Margin="0,0,6,4"
                                ToolTip="Mandant öffnen und im Chat einen Antwortentwurf anfordern"/>
                        <Button Content="📄 Öffnen" Style="{StaticResource LwSmallButton}" Click="OnOeffnen" Tag="{Binding}"
                                Margin="0,0,6,4"/>
                        <Button Content="{Binding GelesenText}" Style="{StaticResource LwSmallButton}" Click="OnGelesen"
                                Tag="{Binding}" Margin="0,0,6,4"/>
                        <Button Content="✕ Entfernen" Style="{StaticResource LwSmallButton}" Click="OnEntfernen"
                                Tag="{Binding}" Margin="0,0,6,4"
                                ToolTip="Falsch zugeordnet — aus dieser Akte entfernen (Datei bleibt erhalten)"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:UnzugeordnetZeile}">
            <Border Background="#0d1117" BorderBrush="#d29922" BorderThickness="1" CornerRadius="6">
                <StackPanel Margin="10,8,10,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="✉" FontSize="15" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding Betreff}" Foreground="#e6edf3" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Meta}" Foreground="#8b949e" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Grund}" Foreground="#d29922" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    <DockPanel Margin="0,7,0,0">
                        <Button DockPanel.Dock="Right" Content="Zuordnen" Style="{StaticResource LwSmallButton}" Click="OnZuordnen"
                                Tag="{Binding}" Margin="6,0,0,0" Background="#238636" Foreground="White" BorderBrush="#2ea043"/>
                        <ComboBox ItemsSource="{Binding Mandanten}" SelectedItem="{Binding Gewaehlt}"
                                  Style="{StaticResource DarkComboBoxStyle}" ToolTip="Mandant auswählen"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="📄 Öffnen" Style="{StaticResource LwSmallButton}" Click="OnUnzugeordnetOeffnen" Tag="{Binding}"/>
                        <Button Content="✕ Keine Kanzleipost" Style="{StaticResource LwSmallButton}" Click="OnVerwerfen" Tag="{Binding}"
                                Margin="6,0,0,0" ToolTip="Lokale Kopie verwerfen — die Mail bleibt im Postfach"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✉ Postfach" Style="{StaticResource LwSmallButton}" Click="OnPostfach"
                            VerticalAlignment="Top" ToolTip="E-Mail-Postfach verbinden bzw. Einstellungen ändern"/>
                    <Button x:Name="AbrufenBtn" DockPanel.Dock="Right" Content="↻" Style="{StaticResource LwSmallButton}"
                            Click="OnAbrufen" VerticalAlignment="Top" Margin="0,0,6,0" Visibility="Collapsed"
                            ToolTip="Postfach jetzt abrufen"/>
                    <TextBlock x:Name="UeberblickText" Foreground="#e6edf3" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock x:Name="PostfachText" Foreground="#8b949e" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="AuswertungText" Foreground="#58a6ff" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                <DockPanel Margin="0,6,0,0">
                    <CheckBox x:Name="NurMandantBox" Content="Nur aktueller Mandant" Style="{StaticResource LwCheckBox}"
                              Checked="OnFilterGeaendert" Unchecked="OnFilterGeaendert"/>
                    <CheckBox x:Name="AuchErledigteBox" Content="Erledigte zeigen" Style="{StaticResource LwCheckBox}"
                              HorizontalAlignment="Right" Checked="OnFilterGeaendert" Unchecked="OnFilterGeaendert"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
            <StackPanel>
                <TextBlock x:Name="UnzugeordnetTitel" Foreground="#d29922" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,6"
                           Visibility="Collapsed"/>
                <ItemsControl x:Name="UnzugeordnetListe">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
                <ItemsControl x:Name="Liste">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
                <TextBlock x:Name="LeerText" Foreground="#8b949e" FontSize="12" TextWrapping="Wrap" Margin="2,8,2,0"
                           Text="Keine neuen Eingänge. Sobald ein Dokument in einem Mandantenordner landet (Schreiben vom Gericht, der Gegenseite, E-Mail des Mandanten …), wertet LexWolf es automatisch aus: Was ist es, was wird verlangt, bis wann, was ist zu tun."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
